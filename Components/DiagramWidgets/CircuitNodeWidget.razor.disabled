@namespace Three2025.Components.DiagramWidgets
@// DISABLED: using Plugin_710.Model
@using FoundryMentorModeler.Diagram
@using Blazor.Diagrams.Components.Renderers
@rendermode @(new InteractiveServerRenderMode(false))

<style>
    .circuit-node {
        border: 2px solid #28a745;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        text-align: center;
        padding: 8px 12px;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        min-width: 120px;
        min-height: 80px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: all 0.2s;
    }

    .circuit-node.selected {
        border-color: #ffd700;
        box-shadow: 0 4px 16px rgba(255,215,0,0.4);
        transform: scale(1.05);
    }

    .node-title {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .node-badge {
        font-size: 0.75em;
        background: rgba(255,255,255,0.2);
        padding: 2px 6px;
        border-radius: 3px;
        display: inline-block;
        margin-top: 5px;
    }
</style>

<div class="circuit-node @(Node.Selected ? "selected" : "")">
    <div class="node-title">⚡ @Node.GetTitle()</div>
    
    @if (HasSubcomponents())
    {
        <div class="node-badge">
            @GetSubcomponentCount() nodes
        </div>
    }

    <!-- Render ports for connections -->
    @foreach (var port in PortList())
    {
        <PortRenderer Port="@port" Class="@port.Alignment.ToString().ToLower()" />
    }
</div>

@code {
    #nullable enable
    [Parameter] public CircuitNodeEditor Node { get; set; } = null!;

    public CircuitNode_710? GetNode()
    {
        return Node?.GetCircuitNode();
    }

    public bool HasSubcomponents()
    {
        return Node?.HasSubcomponents() ?? false;
    }

    public int GetSubcomponentCount()
    {
        return GetNode()?.ModelComponents<CircuitNode_710>().Count() ?? 0;
    }

    public List<DiagramPort> PortList()
    {
        return Node?.Ports.Cast<DiagramPort>().ToList() ?? new List<DiagramPort>();
    }
}
