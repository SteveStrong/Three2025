@page "/debugcanvas"

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@namespace Three2025.Components.Pages
@inherits DebugCanvasBase
@rendermode InteractiveServer

<PageTitle>Debug Canvas 3D - Initialization Test</PageTitle>
<h2>🔍 Debug Canvas 3D - Initialization Test</h2>
<p style="color: red; font-weight: bold;">Testing ViewerThreeD → JavaScript Initialize3DViewer flow</p>

<div class="d-flex">
    <div style="border: 2px solid blue; padding: 10px;">
        <h4>Canvas3DComponent (SceneName="DebugScene")</h4>
        <Canvas3DComponent SceneName="DebugScene" @ref="Canvas3DReference" CanvasWidth="800" CanvasHeight="600" />
    </div>
    

       <BECanvas  Width="800" Height="800" @ref="BECanvasReference"></BECanvas>

    <div style="margin-left: 20px;">
        <h3>Test Controls</h3>
        <button class="btn btn-primary" @onclick="AddSimpleBox">Add Simple Box</button>
        <button class="btn btn-success" @onclick="AddColoredSphere">Add Colored Sphere</button>
        <button class="btn btn-warning" @onclick="ClearScene">Clear Scene</button>
        
        <h4>Debug Info</h4>
        <pre style="background: #f5f5f5; padding: 10px;">@DebugInfo</pre>
        
        <h4>Expected Console Logs:</h4>
        <ol style="font-size: 12px;">
            <li><strong>C# Terminal:</strong> ViewerThreeD [DebugScene] BuildRenderTree called</li>
            <li><strong>C# Terminal:</strong> ViewerThreeD [DebugScene] OnAfterRenderAsync - FIRST RENDER</li>
            <li><strong>Browser Console:</strong> 🚀 Initialize3DViewer called with spec:</li>
            <li><strong>Browser Console:</strong> 🎬 Viewer3D.Initialize3DViewer START</li>
            <li><strong>Browser Console:</strong> ✅ Container found</li>
        </ol>
    </div>
</div>
