@using FoundryMentorModeler.Model
@using Three2025.Apprentice.RackEquipment

@code {
    [Parameter] public RackCabinetConcept Cabinet { get; set; } = null!;
}

<div class="component-details">
    <h4 class="mb-3">🗄️ @Cabinet.Name</h4>
    
    <div class="card mb-3">
        <div class="card-header bg-warning text-dark">
            <h6 class="mb-0">📦 Cabinet Specifications</h6>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <tbody>
                    <tr>
                        <td class="text-muted">Total Rack Units</td>
                        <td><strong>@(Cabinet.FindParameter("TotalRackUnits")?.GetValue().AsNumber() ?? 0) RU</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Total Height</td>
                        <td><strong>@(Cabinet.FindParameter("TotalHeight")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Width</td>
                        <td><strong>@(Cabinet.FindParameter("RackWidth")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Depth</td>
                        <td><strong>@(Cabinet.FindParameter("RackDepth")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Has PDU</td>
                        <td>
                            @if (Cabinet.FindParameter("HasPDU")?.GetValue().AsBoolean() ?? false)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @{
        var usedRU = Cabinet.FindParameter("UsedRU")?.GetValue().AsNumber() ?? 0;
        var totalRU = Cabinet.FindParameter("TotalRackUnits")?.GetValue().AsNumber() ?? 40;
        var availableRU = Cabinet.FindParameter("AvailableRU")?.GetValue().AsNumber() ?? 0;
        var utilization = (usedRU / totalRU * 100);
    }

    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <h6 class="mb-0">📊 Utilization</h6>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">Used</small>
                        <strong class="text-primary">@usedRU RU</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">Available</small>
                        <strong class="text-success">@availableRU RU</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">Total</small>
                        <strong>@totalRU RU</strong>
                    </div>
                </div>
            </div>
            
            <div class="progress" style="height: 30px;">
                <div class="progress-bar @(utilization > 80 ? "bg-danger" : utilization > 60 ? "bg-warning" : "bg-success")" 
                     role="progressbar" 
                     style="width: @(utilization)%;" 
                     aria-valuenow="@utilization" 
                     aria-valuemin="0" 
                     aria-valuemax="100">
                    @utilization.ToString("F1")%
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0">⚙️ Equipment (@(Cabinet.FindParameter("EquipmentCount")?.GetValue().AsNumber() ?? 0) items)</h6>
        </div>
        <div class="card-body" style="max-height: 300px; overflow-y: auto;">
            @{
                var equipment = Cabinet.ModelComponents<RackEquipmentConcept>();
            }
            @if (equipment.Any())
            {
                <div class="list-group">
                    @foreach (var equip in equipment)
                    {
                        var equipHeight = equip.FindParameter("HeightRU")?.GetValue().AsNumber() ?? 0;
                        var equipStart = equip.FindParameter("StartRU")?.GetValue().AsNumber() ?? 0;
                        var equipEnd = equip.FindParameter("EndRU")?.GetValue().AsNumber() ?? 0;
                        var equipColor = equip.FindParameter("Color")?.GetValue().AsString() ?? "gray";
                        
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@equip.Name</strong>
                                    <br>
                                    <small class="text-muted">
                                        RU @equipStart - @equipEnd (@equipHeight RU)
                                    </small>
                                </div>
                                <div>
                                    <span class="badge" style="background-color: @equipColor;">@equipColor</span>
                                    <span class="badge bg-secondary">@equipHeight RU</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">No equipment installed</p>
            }
        </div>
    </div>
</div>
