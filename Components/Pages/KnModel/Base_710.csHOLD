    public bool ReconnectPorts<T>(KnEditor2DParameter parameter, PortModel fromPort, PortModel toPort) where T : DiagramLink
    {
        if (!parameter.IsValid())
            return false;
        
        //$"ReconnectPorts {typeof(T).Name} ".WriteInfo();
        parameter.GetCurrentValueAs<T>((result) => 
        {
            var obj = result.ValueAs<T>();
            obj.Reconnect(fromPort, toPort);
        });
        return true;
    }

    protected T EstablishConnectPorts<T>(KnEditor2DParameter parameter, string color,  PortModel fromPort, PortModel toPort, MentorDiagram diagram) where T : DiagramLink
    {
        if (parameter.IsValid())
            return parameter.GetCurrentValueAs<T>();

        //$"EstablishConnectPorts {typeof(T).Name} {color} ".WriteInfo();
        var result = diagram.ConnectPorts<T>(this, color, fromPort, toPort);

        parameter.SetValue(result);
        parameter.BeforeSmash((p,r) => 
        {
            parameter.ClearCashe();
            diagram.RemoveLink(result);
            //$"Smashing {result.GetTreeNodeTitle()} EstablishConnectPorts".WriteInfo();
        });
        return result;
    }

    protected T EstablishConnectNodes<T>(KnEditor2DParameter parameter, DiagramNode fromNode, DiagramNode toNode, MentorDiagram diagram) where T : DiagramLink
    {
        if (parameter.IsValid())
            return parameter.GetCurrentValueAs<T>();

        //$"EstablishConnectNodes {typeof(T).Name} ".WriteInfo();
        var result = diagram.ConnectNodes<T>(this, fromNode, toNode);
        result.Visible = this.IsVisible;

        parameter.SetValue(result);
        parameter.BeforeSmash((p,r) => 
        {
            parameter.ClearCashe();
            diagram.RemoveLink(result);
            //$"Smashing {link.GetTreeNodeTitle()} EstablishConnectNodes".WriteInfo();
        });
        return result;
    }


    protected T EstablishDiagramNode<T>(KnEditor2DParameter parameter, MentorDiagram diagram) where T : DiagramNode
    {
        if (parameter.IsValid())
            return parameter.GetCurrentValueAs<T>();

        //$"EstablishDiagramNode {typeof(T).Name} ".WriteInfo();
        var (pinX, pinY) = LocationParameters();
        var result = diagram.CreateNode<T>(this, new Point(pinX, pinY))!;
        result.Visible = this.IsVisible;

        parameter.SetValue(result);
        parameter.BeforeSmash((p,r) => {
            parameter.ClearCashe();
            diagram.RemoveNode(result);
            //$"Smashing {node.GetTreeNodeTitle()} EstablishDiagramNode".WriteInfo();
        });

        var (width, height) = SizeParameters();
        result.Size = new Blazor.Diagrams.Core.Geometry.Size(width, height);

        result.Moving += (obj) => {
            var x = obj.Position.X;
            var y = obj.Position.Y;
            UpdateParameter("sPinX", x);
            UpdateParameter("sPinY", y);
            // $"Moving {x} {y}".WriteSuccess();
            GetParentOfType<Model_710>()?.RefreshModelTree(ParameterRefreshAction.Moving, this);
        };

        result.SizeChanged += (obj) => {
            var w = obj.Size?.Width ?? 10.0;
            var h = obj.Size?.Height ?? 10.0;
            UpdateParameter("sWidth", w);
            UpdateParameter("sHeight", h);
            // $"Resizing {w} {h}".WriteSuccess();
             GetParentOfType<Model_710>()?.RefreshModelTree(ParameterRefreshAction.Resizing, this);
        };

        return result;
    }

    protected T EstablishDiagramGroup<T>(KnEditor2DParameter parameter, MentorDiagram diagram) where T : DiagramGroup
    {
        if (parameter.IsValid())
            return parameter.GetCurrentValueAs<T>();

        //$"EstablishDiagramGroup {typeof(T).Name} ".WriteInfo();
        var (pinX, pinY) = LocationParameters();
        var result = diagram.CreateGroup<T>(this, new Point(pinX, pinY))!;
        result.Visible = this.IsVisible;

        parameter.SetValue(result);
        parameter.BeforeSmash((p,r) => {
            parameter.ClearCashe();
            diagram.RemoveGroup(result);
            //$"Smashing {group.GetTreeNodeTitle()} EstablishDiagramGroup".WriteInfo();
        });

        var (width, height) = SizeParameters();
        result.Size = new Blazor.Diagrams.Core.Geometry.Size(width, height);

        result.Moving += (obj) => {
            var x = obj.Position.X;
            var y = obj.Position.Y;
            UpdateParameter("sPinX", x);
            UpdateParameter("sPinY", y);
            //$"Moving EstablishDiagramGroup {x} {y}".WriteSuccess();
            GetParentOfType<Model_710>()?.RefreshModelTree(ParameterRefreshAction.Moving,this);
  
        };

        result.SizeChanged += (obj) => {
            var w = obj.Size?.Width ?? 10.0;
            var h = obj.Size?.Height ?? 10.0;
            UpdateParameter("sWidth", w);
            UpdateParameter("sHeight", h);
            // $"Resizing {w} {h}".WriteSuccess();
             GetParentOfType<Model_710>()?.RefreshModelTree(ParameterRefreshAction.Resizing,this);
        };

        return result;
    }
