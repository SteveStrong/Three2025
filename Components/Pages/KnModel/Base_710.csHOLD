    protected static MockDataGenerator mock = new();

    public int ItemIndex { get; set; } = 0;

    public DT_Component Source { get; set; }



    public KnRelationship HasSub { get; set; } = new KnRelationship(ConnectType.HasSubcomponent.ToString());
    public KnRelationship SubOf { get; set; } = new KnRelationship(ConnectType.ComponentOf.ToString());

    public Base_710(string name) : base(name)
    {
        Add<KnRelationship>(HasSub);
    }
    public Base_710(DT_Component source) : base(source.Name)
    {
        //this lets you save the model recursevly
        Source = source;
        Category = source.Category ?? "Unknown";
        Title = source.GetPart().StructureReference ?? GetName();


        Calculations([
            $"sPinX: 0",
            $"sPinY: 0",
            $"sWidth: 200",
            $"sHeight: 100",
        ]);

        ExtendWithSource(source);

        Add<KnRelationship>(HasSub);
    }

    public string PartTitle => Source.GetPart().Title ?? "";
    public string DisplayName => Source.DisplayName ?? "";
    public string Description => Source.Description ?? "";
    public string SourceURL => MetaData().GetValue("SourceURL") ?? "";

    public virtual void ExtendWithSource(DT_Component source)
    {
        if ( source.HasMetaData())
            MetaData().CloneFrom(source.MetaData());

        if ( source.Position != null)
        {
            var position = source.Position;
            Calculations([
                $"X|{position.xLoc.Units()}: {position.xLoc.Value()}",
                $"Y|{position.yLoc.Units()}: {position.yLoc.Value()}",
                $"Z|{position.zLoc.Units()}: {position.zLoc.Value()}",
                $"Rx|{position.xAng.Units()}: {position.xAng.Value()}",
                $"Ry|{position.yAng.Units()}: {position.yAng.Value()}",
                $"Rz|{position.zAng.Units()}: {position.zAng.Value()}",
            ]);
        }

        if ( source.BoundingBox != null)
        {
            var boundingBox = source.BoundingBox;
            Calculations([
                $"Width|{boundingBox.width.Units()}: {boundingBox.width.Value()}",
                $"Height|{boundingBox.height.Units()}: {boundingBox.height.Value()}",
                $"Depth|{boundingBox.depth.Units()}: {boundingBox.depth.Value()}",
                $"PinX|{boundingBox.pinX.Units()}: {boundingBox.pinX.Value()}",
                $"PinY|{boundingBox.pinY.Units()}: {boundingBox.pinY.Value()}",
                $"PinZ|{boundingBox.pinZ.Units()}: {boundingBox.pinZ.Value()}",
            ]);
        }

    }


    public string StructureRef()
    {
        return Source.GetPart().StructureReference ?? "unknown";
    }

    public virtual void MoveTo(double x, double y)
    {
        EstablishParameter("sPinX").SetValue(x);
        EstablishParameter("sPinY").SetValue(y);
    }

    public Func<Base_710, int> LocPinX = (obj) => obj.EstablishParameter("sWidth").GetCurrentValue().AsInteger() / 2;
    public Func<Base_710, int> LocPinY = (obj) => obj.EstablishParameter("sHeight").GetCurrentValue().AsInteger() / 2;
    public (int pinX, int pinY) LocationParameters()
    {
        var pinX = EstablishParameter("sPinX").GetCurrentValue().AsInteger();
        var pinY = EstablishParameter("sPinY").GetCurrentValue().AsInteger();
        return (pinX, pinY);
    }

    public (int width, int height) SizeParameters()
    {
        var width = EstablishParameter("sWidth").GetCurrentValue().AsInteger();
        var height = EstablishParameter("sHeight").GetCurrentValue().AsInteger();
        return (width, height);
    }

    public List<string> GetTags()
    {
        return Source.GetTags();
    }

    public int GetNextIndex()
    {
        return HasSub.Members<KnComponent>().Count();
    }

    public KnProblem AddProblem(string message)
    {
        var problem = new KnProblem(message);
        Add<KnProblem>(problem);
        return problem;
    }
    public KnProblem AddProblem(OPResult issue)
    {
        var problem = new KnProblem(issue);
        Add<KnProblem>(problem);
        return problem;
    }

    public override OPResult FindSubcomponent<T>(string name) 
    {
        var opResult = new OPResult(name, this);
        opResult.SetUnknownReference($"{name} Subcomponent Not Found on parent {this.Name}");
        
        var list = HasSub.Members<T>();
        var found = list.Where(x => x.GetName().Matches(name))?.FirstOrDefault();
        if ( found != null)
        {
            opResult.SetValue(ResultStatus.Instance, found);
            return opResult;
        }

        return opResult;
    }

