    public override IEnumerable<TreeNodeAction>? GetTreeNodeActions()
    {
        var result = new List<TreeNodeAction>();

        if ( OpenEditor != null && !StatusBits.IsReadOnly)
            result.AddAction("Edit", "btn-success", () => 
            {
                OpenEditor?.Invoke();
            });
            
        if ( OpenViewer != null)
            result.AddAction("View", "btn-primary", () => 
            {
                OpenViewer?.Invoke();
            });

        if (StatusBits.IsVisible)
            result.AddAction("Hide", "btn-danger", () => 
            {
                SetVisible(false, true);
            });
        else
            result.AddAction("Show", "btn-success", () => 
            {
                SetVisible(true, true);
            });

        return result;
    }



    public override bool SetVisible(bool visible, bool deep = true)
    {

        //$"SetVisible {visible} {GetTitle()}  {GetTreeNodeTitle()}".WriteInfo();

        base.SetVisible(visible,deep);

        foreach (var item in Members<KnEditor2DParameter>())
        {
            var editor = item.GetCurrentValueAs<IComponentViewer>();
            editor?.SetVisible(visible, deep);
        }

        if (!deep)
            return visible;
        
        foreach (var item in this.ModelComponents<Base_710>())
            item.SetVisible(visible, deep);
        
        return visible;
    }

    public bool ShowChildren = true;
    public virtual bool ToggleShowChildren()
    {
        ShowChildren = !ShowChildren;
        return ShowChildren;
    }

    public void SmashAllGeometry()
    {
        foreach (var item in Members<KnEditor2DParameter>()) 
            item.Smash();

    }

    public void ClearAllGeometry()
    {
        SmashAllGeometry();

        foreach (var item in this.ModelComponents<Base_710>())
            item.ClearAllGeometry();
    }

    public virtual bool Trace(Dictionary<string,Base_710> pathway)
    {
        return false;
    }
    
    public override List<T> Subcomponents<T>()
    {
        var list = HasSub.Members<T>();
        return list;
    }



    public override string GetTreeNodeTitle()
    {
        var depth = GetKnDepth();
        if (Source == null)
            return $"{Name} [{depth}:{ItemIndex}] ({Category})  ({GetType().Name})";

        var sheet = Source.SystemName;
        return $"{Name} [{depth}:{ItemIndex}:{sheet}] ({Category})  ({GetType().Name})";
    }
    
   public override string ModelReference(ReferenceFormat format, int depth)
    {
        if ( depth == 0 || !HasKnParent())
            return Name ?? "...";

        if (format == ReferenceFormat.Local)
            return Name ?? "...";

        var path = GetKnParent().ModelReference(format, depth-1);
        return $"{path}.{Name}";
    }

    public void AddNonNullProperty(string name, string value, string unit = "")
    {
        if (!string.IsNullOrEmpty(value))
            Parameter(name, value, unit);
    }



    public string UniversalID()
    {
        if ( Source == null)
            return "";
        return Source.GetPart()?.StructureReference ?? "";
    }

    public int StructureDepth()
    {
        var leg = Source.GetPart()?.StructureReference ?? "";
        return leg.Split('.').Length;
    }





    public string ComputeTitle()
    {
        var result = UniversalID();
        var parent = GetKnParent() as Base_710;
        if ( parent == null)
        {
            $"ComputeTitle: Parent is NULL  {result}".WriteError();
            return result;
        }

        var mask = parent.UniversalID() + ".";
        result = result.Replace(mask, "");
        return result;
    }


    public (string start, string finish, string address) MetaEndpoints(DT_Component item)
    {
        var meta = item.MetaData();

        var start = meta.GetValue("Start")!;
        var finish = meta.GetValue("Finish")!;
        var address = meta.GetValue("Address");
        return (start, finish, address);
    }

    public (OPResult start, OPResult finish) Endpoints(DT_Component item, Dictionary<string, Base_710> lookup, bool reportProblems = true)
    {
        var (start,finish,address) = MetaEndpoints(item);

        //$"Endpoints MetaData: {address} {item.name} Start:{start} => Finish:{finish}".WriteInfo();

        var startRef = Common_710.SubComponentReference<Base_710>(this, start, lookup);
        startRef.Tag = start;
        var finishRef = Common_710.SubComponentReference<Base_710>(this, finish, lookup);
        finishRef.Tag = finish;

        if (startRef.IsReference() && finishRef.IsReference())
        {
            return (startRef, finishRef);
        }


        if (startRef.IsError($"{address} {item.Name}: start [{start}]: ") && reportProblems)
            AddProblem(startRef);

        if (finishRef.IsError($"{address} {item.Name}: finish [{finish}]: ") && reportProblems)
            AddProblem(finishRef);
            
        return (startRef, finishRef);
    }

    public T CreateInFolder<T>(Base_710 parent, DT_Component component, int index, Dictionary<string, Base_710> lookup) where T : Base_710
    {
        var name = typeof(T).Name.Replace("_710","s");
        var folder = Common_710.EstablishFolder(name,parent);
        var obj = FindOrBuild<Folder_710,T>(folder,component, index, lookup);
        return obj;
    }

    public List<T> BuildAndConnect<U,T>(U parent, IEnumerable<DT_Component> items, Dictionary<string, Base_710> lookup) where U: Base_710 where T: Base_710
    {
        var list = new List<T>();
        if ( items == null || items.Count() == 0) return list;

        var count = 0;
        foreach (var item in items)
        {
            var obj = FindBuildAndConnect<U,T>(parent,item,count++,lookup);
            list.Add(obj);
        }

        return list;
    }

    public T FindBuildAndConnect<U,T>(U parent, DT_Component item, int index, Dictionary<string, Base_710> lookup) where U: Base_710 where T: Base_710
    {

        // now do the linking between the components
        var (startRef, finishRef) = Endpoints(item,lookup,true);
        //$"ENDPOINTS: {startRef.GetCategory()} {startRef.Name} => {finishRef.GetCategory()} {finishRef.Name}".WriteInfo(1);

        //var obj = CreateInFolder<T>(parent,item,index,lookup);
        var obj = FindOrBuild<U,T>(parent,item, index, lookup);
        obj.Title = item.Description ?? "";

        if (startRef.IsReference() && finishRef.IsReference())
        {
            obj.BuildConnection(startRef, finishRef, parent, lookup);
        } 
        else if (obj != null)
        {
            // need to verify that the endpoints are compatable with the type of connection we are creating
            // if not lets queue future work to fix the problem
            if (obj.VerifyEndpoints(startRef, finishRef, lookup))
            {
                obj.BuildConnection(startRef, finishRef, parent, lookup);
            }

        }

        obj?.BuildStructure(item.GetMembers(), obj, lookup);  //build out structure for cables
        return obj!;
    }

    public V FindOrBuild<U,V>(U parent, DT_Component component, int index, Dictionary<string, Base_710> lookup) where U: Base_710 where V : Base_710
    {
        var key = component.GetPart().StructureReference ?? "";
        if (lookup.TryGetValue(key, out Base_710? value) == false)
        {
            V obj = (V)Activator.CreateInstance(typeof(V), component, index, this)!;
            Common_710.AddHasSubpart<U, V>(parent, obj);
            lookup.TryAdd(obj.UniversalID(), obj);
            return obj;
        }
        else 
        {
            value.ExtendWithSource(component);
        }

        //the structure may be different, try a merge also

        //$"Finding {value.GetTreeNodeTitle()} {value.GetType().Name}".WriteInfo();
        if ( value is V)
            return (V)value;

        var other = component.ShallowCopy();
        var part = other.GetPart();
        part.StructureReference += "*";
        $"Creating Alterate,  New Name: {part.StructureReference} of type {typeof(V).Name}".WriteInfo(1);   
        return FindOrBuild<U,V>(parent, other, index, lookup);




        //$"---Building {obj.GetTreeNodeTitle()}".WriteInfo();

    }

