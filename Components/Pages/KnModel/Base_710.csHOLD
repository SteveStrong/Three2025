    public virtual bool VerifyEndpoints(OPResult start, OPResult finish, Dictionary<string, Base_710> lookup)
    {
        var solution = GetParentOfType<Solution_710>();
        if ( start.IsError() )
            solution?.AddProblem(start);
            
        if ( finish.IsError() )
            solution?.AddProblem(finish);

        return !start.IsError() && !finish.IsError();
    }

    public List<Hyperlink> GetHyperlinks()
    {
        return new List<Hyperlink>();
