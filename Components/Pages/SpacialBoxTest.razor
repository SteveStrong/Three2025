@page "/spacialboxtest"

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D

@using FoundryBlazor.Shared
@using FoundryBlazor.Shape
@using BlazorThreeJS.Viewers
@using BlazorThreeJS.Maths
@using Three2025.Shared
@inherits SpacialBoxTestBase
@rendermode InteractiveServer

@namespace Three2025.Components.Pages

<h3>SpacialBox3D Test Page</h3>

<div class="d-flex">
    <Canvas3DComponent SceneName="SpacialBoxScene" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
    <div class="controls-panel" style="margin-left: 10px; width: 300px; overflow-y: auto; max-height: 1000px;">
        
        <h4>Box Creation</h4>
        <div class="control-group">
            <label>Width:</label>
            <input type="number" @bind="BoxWidth" min="0.1" max="10" step="0.1" />
        </div>
        <div class="control-group">
            <label>Height:</label>
            <input type="number" @bind="BoxHeight" min="0.1" max="10" step="0.1" />
        </div>
        <div class="control-group">
            <label>Depth:</label>
            <input type="number" @bind="BoxDepth" min="0.1" max="10" step="0.1" />
        </div>
        
        <button class="btn btn-primary" @onclick="CreateSpacialBox">Create SpacialBox</button>
        
        <h4>Preset Shapes</h4>
        <div class="preset-buttons">
            <button class="btn btn-outline-primary" @onclick="CreateCube">Cube (2×2×2)</button>
            <button class="btn btn-outline-primary" @onclick="CreateLongBox">Long Box (4×1×1)</button>
            <button class="btn btn-outline-primary" @onclick="CreateTallBox">Tall Box (1×4×1)</button>
            <button class="btn btn-outline-primary" @onclick="CreateWideBox">Wide Box (1×1×4)</button>
            <button class="btn btn-outline-primary" @onclick="CreateTinyBox">Tiny Box (0.5×0.5×0.5)</button>
        </div>
        

        
        <h4>Geometric Analysis</h4>
        <div class="analysis-buttons">
            <button class="btn btn-outline-info" @onclick="ShowDiagonals">Show Diagonals</button>
            <button class="btn btn-outline-info" @onclick="ShowCenterCross">Center Cross</button>
            <button class="btn btn-outline-info" @onclick="ShowQuadrants">Show Quadrants</button>
        </div>
        
            <h4>Box Visualization</h4>
            <div class="visual-buttons">
                <button class="btn btn-outline-success" @onclick="ShowVertices">Show Vertices</button>
                <button class="btn btn-outline-success" @onclick="ShowEdges">Show Edges</button>
                <button class="btn btn-outline-success" @onclick="ShowFaces">Show Faces</button>
                <button class="btn btn-outline-success" @onclick="ShowNormals">Show Normals</button>
            </div>

        
        <h4>Scene Controls</h4>
        <div class="scene-buttons">
            <button class="btn btn-danger" @onclick="ClearAll">Clear</button>
        </div>
        
        <h4>Box Information</h4>
        @if (CurrentBox != null)
        {
            <div class="info-panel">
                <p><strong>Dimensions:</strong> @CurrentBox.Width × @CurrentBox.Height × @CurrentBox.Depth @CurrentBox.Units</p>
                <p><strong>Volume:</strong> @CurrentBox.Volume.ToString("F2") @CurrentBox.Units³</p>
                <p><strong>Surface Area:</strong> @CurrentBox.SurfaceArea.ToString("F2") @CurrentBox.Units²</p>
                <p><strong>Center:</strong> (@CurrentBox.Center.X.ToString("F2"), @CurrentBox.Center.Y.ToString("F2"), @CurrentBox.Center.Z.ToString("F2"))</p>
                <p><strong>Vertices Count:</strong> @CurrentBox.Vertices.Count</p>
                <p><strong>Face Centers Count:</strong> @CurrentBox.FaceCenters.Count</p>
                <p><strong>Edge Centers Count:</strong> @CurrentBox.EdgeCenters.Count</p>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="alert alert-info">
                @StatusMessage
            </div>
        }
    </div>
</div>

<style>
    .control-group {
        margin: 5px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .control-group label {
        min-width: 60px;
    }
    
    .info-panel {
        background: #f8f9fa;
        padding: 10px;
        border-radius: 5px;
        margin: 10px 0;
    }
    
    .info-panel p {
        margin: 5px 0;
    }
    
    .btn {
        margin: 2px 0;
        width: 100%;
        font-size: 12px;
        padding: 5px 8px;
    }
    
    .controls-panel {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    
    .controls-panel h4 {
        margin: 15px 0 10px 0;
        font-size: 14px;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 5px;
    }
    
    .controls-panel h4:first-child {
        margin-top: 0;
    }
    
    .preset-buttons, .visual-buttons, .face-buttons, .edge-buttons, 
    .analysis-buttons, .multi-buttons, .transform-buttons, .measure-buttons, .scene-buttons {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 10px;
    }
    
    .d-flex {
        gap: 20px;
    }
</style>
