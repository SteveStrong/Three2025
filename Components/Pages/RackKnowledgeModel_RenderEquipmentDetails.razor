@using FoundryMentorModeler.Model
@using Three2025.Apprentice.RackEquipment

@code {
    [Parameter] public RackEquipmentConcept Equipment { get; set; } = null!;
}

<div class="component-details">
    <h4 class="mb-3">⚙️ @Equipment.Name</h4>
    
    <div class="card mb-3">
        <div class="card-header text-white" style="background-color: @(Equipment.FindParameter("Color")?.GetValue().AsString() ?? "gray");">
            <h6 class="mb-0">🔧 Equipment Specifications</h6>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <tbody>
                    <tr>
                        <td class="text-muted">Type</td>
                        <td><strong>@Equipment.GetType().Name.Replace("Concept", "")</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Height (RU)</td>
                        <td><strong>@(Equipment.FindParameter("HeightRU")?.GetValue().AsNumber() ?? 0) RU</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Height (inches)</td>
                        <td><strong>@(Equipment.FindParameter("HeightInches")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Width</td>
                        <td><strong>@(Equipment.FindParameter("Width")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Depth</td>
                        <td><strong>@(Equipment.FindParameter("Depth")?.GetValue().AsNumber() ?? 0) inches</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Color</td>
                        <td>
                            <span class="badge" style="background-color: @(Equipment.FindParameter("Color")?.GetValue().AsString() ?? "gray");">
                                @(Equipment.FindParameter("Color")?.GetValue().AsString() ?? "gray")
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0">📍 Position in Rack</h6>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">Start RU</small>
                        <strong class="text-primary">@(Equipment.FindParameter("StartRU")?.GetValue().AsNumber() ?? 0)</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">End RU</small>
                        <strong class="text-danger">@(Equipment.FindParameter("EndRU")?.GetValue().AsNumber() ?? 0)</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded text-center">
                        <small class="text-muted d-block">Height</small>
                        <strong class="text-success">@(Equipment.FindParameter("HeightRU")?.GetValue().AsNumber() ?? 0) RU</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0">📐 Calculated Dimensions</h6>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-2">
                <small>
                    <strong>Formula:</strong> HeightInches = HeightRU × RackUnitHeight<br>
                    <strong>Calculation:</strong> @(Equipment.FindParameter("HeightRU")?.GetValue().AsNumber() ?? 0) RU × 
                    @(Equipment.FindParameter("RackUnitHeight")?.GetValue().AsNumber() ?? 1.75) in = 
                    @(Equipment.FindParameter("HeightInches")?.GetValue().AsNumber() ?? 0) inches
                </small>
            </div>
            
            <div class="alert alert-warning mb-0">
                <small>
                    <strong>Standard:</strong> 1 Rack Unit (RU) = 1.75 inches = 44.45 mm
                </small>
            </div>
        </div>
    </div>

    @* Show additional properties for specific equipment types *@
    @if (Equipment is ZIFConnectorConcept)
    {
        <div class="card mt-3">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">🔌 ZIF Connector Properties</h6>
            </div>
            <div class="card-body">
                <p><strong>Slot Count:</strong> @(Equipment.FindParameter("SlotCount")?.GetValue().AsNumber() ?? 0)</p>
            </div>
        </div>
    }
    else if (Equipment is StorageDrawerConcept)
    {
        <div class="card mt-3">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">📦 Storage Drawer Properties</h6>
            </div>
            <div class="card-body">
                <p><strong>Has Handle:</strong> 
                    @if (Equipment.FindParameter("HasHandle")?.GetValue().AsBoolean() ?? false)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </p>
            </div>
        </div>
    }
    else if (Equipment is ITAConcept)
    {
        <div class="card mt-3">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">💻 ITA Properties</h6>
            </div>
            <div class="card-body">
                <p><strong>Device Number:</strong> @(Equipment.FindParameter("DeviceNumber")?.GetValue().AsNumber() ?? 0)</p>
                <p class="mb-0"><strong>Label:</strong> @(Equipment.FindParameter("Label")?.GetValue().AsString() ?? "")</p>
            </div>
        </div>
    }
</div>
