@page "/mentor2d-modeler"
@namespace Three2025.Components.Pages
@using FoundryMentorModeler.Model
@using FoundryWorldsAndDrawings.Shape
@using FoundryWorldsAndDrawings.Solutions
@using Three2025.Components.Shared
@inject IMentorServices MentorServices
@inject IWorkspace Workspace
@rendermode InteractiveServer

<PageTitle>Mentor 2D Visual Modeler</PageTitle>

<div class="mentor2d-page">
    <!-- Toolbar -->
    <div class="toolbar">
        <div class="toolbar-section">
            <span class="section-label">Knowledge Types</span>
            <button class="tool-btn concept" @onclick="() => CreateKnowledgeShape(KnowledgeType.Concept)" title="Concept - Entities and Classes">
                📘 Concept
            </button>
            <button class="tool-btn property" @onclick="() => CreateKnowledgeShape(KnowledgeType.Property)" title="Property - Attributes and Fields">
                📋 Property
            </button>
            <button class="tool-btn role" @onclick="() => CreateKnowledgeShape(KnowledgeType.Role)" title="Role - Hierarchical Behaviors">
                👤 Role
            </button>
            <button class="tool-btn context" @onclick="() => CreateKnowledgeShape(KnowledgeType.Context)" title="Context - Question Groups">
                📦 Context
            </button>
            <button class="tool-btn component" @onclick="() => CreateKnowledgeShape(KnowledgeType.Component)" title="Component - Physical Parts">
                🔧 Component
            </button>
            <button class="tool-btn formula" @onclick="() => CreateKnowledgeShape(KnowledgeType.Formula)" title="Formula - Calculations">
                ƒ Formula
            </button>
            <button class="tool-btn feature" @onclick="() => CreateKnowledgeShape(KnowledgeType.Feature)" title="Feature - Typed Properties">
                ⚙️ Feature
            </button>
            <button class="tool-btn relation" @onclick="() => CreateKnowledgeShape(KnowledgeType.Relation)" title="Relation - Links Between Concepts">
                🔗 Relation
            </button>
            <button class="tool-btn variable" @onclick="() => CreateKnowledgeShape(KnowledgeType.Variable)" title="Variable - Formula Variables">
                🔢 Variable
            </button>
            <button class="tool-btn validvalues" @onclick="() => CreateKnowledgeShape(KnowledgeType.ValidValues)" title="Valid Values - Enumeration">
                ✓ ValidValues
            </button>
        </div>

        <div class="toolbar-section">
            <span class="section-label">Actions</span>
            <button class="action-btn" @onclick="ClearCanvas" title="Clear Canvas">
                🗑️ Clear
            </button>
            <button class="action-btn" @onclick="SaveModel" title="Save Model">
                💾 Save
            </button>
            <button class="action-btn" @onclick="LoadModel" title="Load Model">
                📂 Load
            </button>
        </div>

        <div class="toolbar-section">
            <span class="section-label">Examples</span>
            <button class="example-btn" @onclick="CreateBeamExample" title="Create Simple Beam Model">
                🔨 Beam
            </button>
            <button class="example-btn" @onclick="CreateStrategicPlanExample" title="Create Strategic Plan">
                📊 Strategic Plan
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-container">
        <!-- Canvas Area (Left Side - 70%) -->
        <div class="canvas-panel" style="width: 70%">
            <div class="canvas-header">
                <h3>🎨 2D Canvas</h3>
                <div class="canvas-controls">
                    <span class="shape-count">Shapes: @ShapeCount</span>
                    <span class="zoom-level">Zoom: 100%</span>
                </div>
            </div>
            <div class="canvas-wrapper" @ref="canvasContainer">
                <!-- Canvas will be rendered here by the IDrawing system -->
                <div class="canvas-placeholder">
                    @if (ShapeCount == 0)
                    {
                        <div class="empty-canvas-message">
                            <h4>👆 Click a button above to create your first shape!</h4>
                            <p>Or try an example to see the system in action.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel - Model Tree & Status (30%) -->
        <div class="info-panel" style="width: 30%">
            <!-- Model Tree -->
            <div class="tree-section">
                <div class="section-header">
                    <h4>🌳 Model Structure</h4>
                    <button class="compact-btn" @onclick="RefreshTree" title="Refresh Tree">
                        🔄
                    </button>
                </div>
                <div class="tree-content">
                    @if (ModelTreeItems.Count == 0)
                    {
                        <p class="hint">No model yet - create shapes to build model</p>
                    }
                    else
                    {
                        <div class="tree-list">
                            @foreach (var item in ModelTreeItems)
                            {
                                <div class="tree-item" @onclick="() => SelectShape(item)">
                                    <span class="tree-icon">@GetKnowledgeTypeIcon(item.Type)</span>
                                    <span class="tree-name">@item.Name</span>
                                    @if (item.Children.Count > 0)
                                    {
                                        <span class="tree-count">(@item.Children.Count)</span>
                                    }
                                </div>
                                @if (item.Children.Count > 0)
                                {
                                    <div class="tree-children">
                                        @foreach (var child in item.Children)
                                        {
                                            <div class="tree-item child" @onclick="() => SelectShape(child)">
                                                <span class="tree-icon">@GetKnowledgeTypeIcon(child.Type)</span>
                                                <span class="tree-name">@child.Name</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Status Log -->
            <div class="log-section">
                <div class="section-header">
                    <h4>📝 Activity Log</h4>
                    <button class="compact-btn" @onclick="ClearLog" title="Clear Log">
                        ✖️
                    </button>
                </div>
                <div class="log-content">
                    @foreach (var entry in ActivityLog.TakeLast(20))
                    {
                        <div class="log-entry @entry.Level">
                            <span class="log-time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                            <span class="log-message">@entry.Message</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Instructions -->
            <div class="help-section">
                <h4>💡 Tips</h4>
                <ul class="help-list">
                    <li>Click toolbar buttons to create shapes</li>
                    <li>Shapes appear at auto-positioned locations</li>
                    <li>Drag shapes to reposition them</li>
                    <li>Drag shape onto another to attach (if valid)</li>
                    <li>Green highlight = valid attachment</li>
                    <li>Red highlight = invalid attachment</li>
                    <li>Delete key removes selected shapes</li>
                </ul>
            </div>
        </div>
    </div>
</div>

