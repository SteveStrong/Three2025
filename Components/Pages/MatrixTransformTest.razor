@page "/matrix-transform-test"
@using BlazorThreeJS.Maths
@using BlazorThreeJS.Viewers
@using FoundryBlazor.Shape
@using BlazorThreeJS.Cameras
@using BlazorThreeJS.Helpers
@using FoundryBlazor.Shared
@using Three2025.Shared

@rendermode InteractiveServer

<PageTitle>Matrix Transformation Test</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">🧮 Matrix Transformation Test</h1>
            <p class="text-muted">Interactive 3D matrix transformation visualization and reverse engineering tool</p>
        </div>
    </div>

    <div class="row">
        <!-- Control Panel -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>🎛️ Transformation Controls</h5>
                </div>
                <div class="card-body">
                    <!-- Original Point -->
                    <div class="mb-3">
                        <label class="form-label"><strong>📍 Original Point</strong></label>
                        <div class="row">
                            <div class="col">
                                <label>X:</label>
                                <input type="number" @bind="originalPoint.X" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="0.5" />
                            </div>
                            <div class="col">
                                <label>Y:</label>
                                <input type="number" @bind="originalPoint.Y" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="0.5" />
                            </div>
                            <div class="col">
                                <label>Z:</label>
                                <input type="number" @bind="originalPoint.Z" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="0.5" />
                            </div>
                        </div>
                    </div>

                    <!-- Transform3 Controls -->
                    <div class="mb-3">
                        <label class="form-label"><strong>🔄 Transform3 Properties</strong></label>
                        <br/>
                        <!-- Position -->
                        <label class="small">Position:</label>
                        <div class="row mb-2">
                            <div class="col">
                                <input type="number" @bind="workingPosition.X" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1.0" placeholder="X" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingPosition.Y" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1.0" placeholder="Y" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingPosition.Z" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1.0" placeholder="Z" />
                            </div>
                        </div>

                        <!-- Rotation (Degrees) -->
                        <label class="small">Rotation (degrees):</label>
                        <div class="row mb-2">
                            <div class="col">
                                <input type="number" @bind="rotationDegrees.X" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="45" placeholder="X°" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="rotationDegrees.Y" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="45" placeholder="Y°" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="rotationDegrees.Z" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="45" placeholder="Z°" />
                            </div>
                        </div>

                        <!-- Scale -->
                        @* <label class="small">Scale:</label>
                        <div class="row mb-2">
                            <div class="col">
                                <input type="number" @bind="workingScale.X" @bind:event="oninput" 
                                       @onchange="ApplyScaleChanges"
                                       class="form-control form-control-sm" step="0.1" placeholder="X" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingScale.Y" @bind:event="oninput" 
                                       @onchange="ApplyScaleChanges"
                                       class="form-control form-control-sm" step="0.1" placeholder="Y" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingScale.Z" @bind:event="oninput" 
                                       @onchange="ApplyScaleChanges"
                                       class="form-control form-control-sm" step="0.1" placeholder="Z" />
                            </div>
                        </div> *@

                        <!-- Pivot -->
                        <label class="small">Pivot:</label>
                        <div class="row mb-2">
                            <div class="col">
                                <input type="number" @bind="workingPivot.X" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1" placeholder="X" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingPivot.Y" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1" placeholder="Y" />
                            </div>
                            <div class="col">
                                <input type="number" @bind="workingPivot.Z" @bind:event="oninput" 
                                       @onchange="UpdateMatrixFromUIData"
                                       class="form-control form-control-sm" step="1" placeholder="Z" />
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="mb-3">
                        <label class="form-label"><strong>⚡ Quick Actions</strong></label>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary btn-sm" @onclick="ResetTransform">Reset Transform</button>
                            @* <button class="btn btn-outline-success btn-sm" @onclick="TestKnownMatrix">Test Known Matrix</button> *@
                        </div>
                    </div>
                </div>
            </div>

            <!-- Matrix Display -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5>📊 Current Transformation Matrix</h5>
                </div>
                <div class="card-body">
                    <div class="font-monospace small" style="white-space: pre-line;">@currentMatrixDisplay</div>
                    
                    <!-- Matrix Properties -->
                    <div class="row mt-3">
                        <div class="col">
                            <small class="text-muted">
                                <strong>Matrix Status:</strong> @(MainTransform.IsDirty ? "🔄 Dirty (needs recalc)" : "✅ Clean (cached)")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
  
        </div>

        <!-- Visualization Panel -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>👁️ 3D Visualization</h5>
                </div>
                <div class="card-body">
  
                    <Canvas3DComponent SceneName="MatrixTestScene" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />

                    
                    <!-- Point Information -->
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="card border-primary">
                                <div class="card-body p-2">
                                    <h6 class="card-title text-primary">📍 Original Point (Blue)</h6>
                                    <div class="text-monospace small">
                                        X: @originalPoint.X.ToString("F3")<br/>
                                        Y: @originalPoint.Y.ToString("F3")<br/>
                                        Z: @originalPoint.Z.ToString("F3")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-success">
                                <div class="card-body p-2">
                                    <h6 class="card-title text-success">🎯 Transformed Point (Green)</h6>
                                    <div class="text-monospace small">
                                        X: @transformedPoint.X.ToString("F3")<br/>
                                        Y: @transformedPoint.Y.ToString("F3")<br/>
                                        Z: @transformedPoint.Z.ToString("F3")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-danger">
                                <div class="card-body p-2">
                                    <h6 class="card-title text-danger">⚡ Pivot Point (Red)</h6>
                                    <div class="text-monospace small">
                                        X: @workingPivot.X.ToString("F3")<br/>
                                        Y: @workingPivot.Y.ToString("F3")<br/>
                                        Z: @workingPivot.Z.ToString("F3")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Rotation center</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>


</div>

<style>
    .text-monospace {
        font-family: 'Courier New', monospace;
    }
    
    .form-control-sm {
        font-size: 0.8rem;
    }
    
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
</style>
