@page "/spacialframetest"

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D

@using FoundryBlazor.Shared
@using FoundryBlazor.Shape
@using BlazorThreeJS.Viewers
@using BlazorThreeJS.Maths
@using Three2025.Shared

@rendermode InteractiveServer

@namespace Three2025.Components.Pages

<h3>SpacialFrame3D Test Page</h3>

<div class="d-flex">
    <Canvas3D SceneName="SpacialFrameScene" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
    <div class="controls-panel" style="margin-left: 10px; width: 350px; overflow-y: auto; max-height: 1000px;">
        
        <h4>Scene Controls</h4>
        <div class="scene-buttons">
            <button class="btn btn-danger" @onclick="ClearAll">Clear</button>
        </div>

        
        <h4>Preset Shapes</h4>
        <div class="preset-buttons">
            <button class="btn btn-outline-primary" @onclick="CreateCube">Cube (2×2×2)</button>
            <button class="btn btn-outline-primary" @onclick="CreateLongBox">Long Box (4×1×1)</button>
            <button class="btn btn-outline-primary" @onclick="CreateTallBox">Tall Box (1×4×1)</button>
            <button class="btn btn-outline-primary" @onclick="CreateWideBox">Wide Box (1×1×4)</button>
            <button class="btn btn-outline-primary" @onclick="CreateTinyBox">Tiny Box (0.5×0.5×0.5)</button>
        </div>

        <h4>Box Visualization</h4>
        <div class="visual-buttons">
            <button class="btn btn-outline-success" @onclick="ShowVertices">Show Vertices</button>
            <button class="btn btn-outline-success" @onclick="ShowEdges">Show Edges</button>
            <button class="btn btn-outline-success" @onclick="ShowFaces">Show Faces</button>
            <button class="btn btn-outline-success" @onclick="ShowNormals">Show Normals</button>
            <button class="btn btn-outline-success" @onclick="ShowQuadrants">Show Quadrants</button>
        </div>

        <h4>Transformation Controls</h4>
        
        <!-- Position Controls -->
        <div class="transform-section">
            <h5>Position</h5>
            <div class="control-group">
                <label>X:</label>
                <input type="number" step="0.1" @bind="PositionX" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPositionX">+1</button>
            </div>
            <div class="control-group">
                <label>Y:</label>
                <input type="number" step="0.1" @bind="PositionY" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPositionY">+1</button>
            </div>
            <div class="control-group">
                <label>Z:</label>
                <input type="number" step="0.1" @bind="PositionZ" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPositionZ">+1</button>
            </div>
        </div>

        <!-- Rotation Controls -->
        <div class="transform-section">
            <h5>Rotation (degrees) <small class="text-muted">→ auto-converted to radians</small></h5>
            <div class="control-group">
                <label>X:</label>
                <input type="number" step="1" @bind="RotationX" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="ApplyQuickRotationX90">+90°</button>
            </div>
            <div class="control-group">
                <label>Y:</label>
                <input type="number" step="1" @bind="RotationY" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="ApplyQuickRotationY90">+90°</button>
            </div>
            <div class="control-group">
                <label>Z:</label>
                <input type="number" step="1" @bind="RotationZ" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="ApplyQuickRotationZ90">+90°</button>
            </div>
        </div>

        @* <!-- Scale Controls -->
        <div class="transform-section">
            <h5>Scale</h5>
            <div class="control-group">
                <label>X:</label>
                <input type="number" step="0.1" min="0.1" @bind="ScaleX" @bind:after="UpdateTransform" />
            </div>
            <div class="control-group">
                <label>Y:</label>
                <input type="number" step="0.1" min="0.1" @bind="ScaleY" @bind:after="UpdateTransform" />
            </div>
            <div class="control-group">
                <label>Z:</label>
                <input type="number" step="0.1" min="0.1" @bind="ScaleZ" @bind:after="UpdateTransform" />
            </div>
        </div> *@

        <!-- Pivot Controls -->
        <div class="transform-section">
            <h5>Pivot Point</h5>
            <div class="control-group">
                <label>X:</label>
                <input type="number" step="0.1" @bind="PivotX" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPivotX">+1</button>
            </div>
            <div class="control-group">
                <label>Y:</label>
                <input type="number" step="0.1" @bind="PivotY" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPivotY">+1</button>
            </div>
            <div class="control-group">
                <label>Z:</label>
                <input type="number" step="0.1" @bind="PivotZ" @bind:after="AutoRefreshShape" />
                <button class="btn btn-sm btn-secondary" @onclick="IncrementPivotZ">+1</button>
            </div>
        </div>

        <!-- Transform Buttons -->
        <div class="transform-buttons">
            <button class="btn btn-warning" @onclick="ResetTransform">Reset Transform</button>
            <button class="btn btn-dark" @onclick="ShowTransformMatrix">Show Matrix</button>
        </div>

        <h4>🔍 Transformation Debugging</h4>
        <div class="debug-buttons">
        </div>



        
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="alert alert-info">
                @StatusMessage
            </div>
        }
    </div>
    <div class="controls-panel" style="margin-left: 10px; width: 350px; overflow: auto; max-height: 1000px;">
        <RadzenShapeTreeView/>
    </div>
</div>

<style>
    .control-group {
        margin: 5px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .control-group label {
        min-width: 20px;
        font-weight: bold;
        color: #495057;
    }
    
    .control-group input {
        flex: 1;
        padding: 4px 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 12px;
    }
    
    .transform-section {
        margin: 15px 0;
        padding: 10px;
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 5px;
    }
    
    .transform-section h5 {
        margin: 0 0 10px 0;
        font-size: 13px;
        color: #6c757d;
        text-transform: uppercase;
        font-weight: 600;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 5px;
    }
    
    .info-panel {
        background: #f8f9fa;
        padding: 10px;
        border-radius: 5px;
        margin: 10px 0;
    }
    
    .info-panel p {
        margin: 5px 0;
    }
    
    .btn {
        margin: 2px 0;
        width: 100%;
        font-size: 12px;
        padding: 5px 8px;
    }
    
    .btn-sm {
        width: auto;
        padding: 2px 6px;
        font-size: 10px;
        margin-left: 5px;
    }
    
    .controls-panel {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    
    .controls-panel h4 {
        margin: 15px 0 10px 0;
        font-size: 14px;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 5px;
    }
    
    .controls-panel h4:first-child {
        margin-top: 0;
    }
    
    .preset-buttons, .visual-buttons, .face-buttons, .edge-buttons, 
    .analysis-buttons, .multi-buttons, .transform-buttons, .measure-buttons, .scene-buttons, .debug-buttons {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 10px;
    }
    
    .d-flex {
        gap: 20px;
    }
</style>
