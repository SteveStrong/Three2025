@page "/tugofwar"

@using FoundryWorldsAndDrawings.Shared
@using FoundryWorldsAndDrawings.Shape

@inherits TugOfWarBase
@rendermode InteractiveServer

@namespace Three2025.Components.Pages

<h3>Tug of War Test - 2D vs 3D Animation Comparison</h3>

<div style="margin-bottom: 15px; padding: 10px; background-color: #e3f2fd; border-radius: 5px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <button class="btn btn-success" @onclick="StartBothAnimations">Start Both Animations</button>
        <button class="btn btn-warning" @onclick="ResetBoth">Reset Both</button>
    </div>
    <div style="font-family: monospace; font-size: 16px; font-weight: bold;">
        <span style="margin-right: 20px;">FPS: @_currentFps.ToString("F1")</span>
        <span>Tick: @_currentTick</span>
    </div>
</div>

<div style="display: flex; gap: 20px; margin-top: 20px;">
    <div style="flex: 1;">
        <h4>2D Canvas (Tween Animation)</h4>
        <div style="margin-bottom: 10px;">
            <button class="btn btn-primary" @onclick="StartTugOfWar2D">Start 2D Tug of War</button>
            <button class="btn btn-secondary" @onclick="Reset2D">Reset 2D</button>
        </div>
        <Canvas2DComponent SceneName="TugOfWar2D" @ref="Canvas2DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight WithAnimations="true" />
    </div>

    <div style="flex: 1;">
        <h4>3D Canvas (Transform Animation)</h4>
        <div style="margin-bottom: 10px;">
            <button class="btn btn-primary" @onclick="StartTugOfWar3D">Create Scene</button>
            <button class="btn btn-success" @onclick="StartAnimation3D">Start Animation</button>
            <button class="btn btn-danger" @onclick="StopAnimation3D">Stop</button>
            <button class="btn btn-secondary" @onclick="Reset3D">Reset</button>
        </div>
        <Canvas3DComponent SceneName="TugOfWar3D" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight WithAnimations="true" />
    </div>
</div>

<div style="margin-top: 20px; padding: 10px; background-color: #f5f5f5; border-radius: 5px;">
    <h5>Test Details:</h5>
    <ul>
        <li><strong>2D Test:</strong> Two shapes (Blue and Orange) connected by a cyan arrow. They animate using GlideTween.</li>
        <li><strong>3D Test:</strong> 
            <ul>
                <li>Tug-of-War: Two boxes (blue & orange) moving apart with connecting cyan tube</li>
                <li>Static Triangle: Three boxes connected by pipes</li>
                <li>Growing Pipe: Vertical cyan tube growing from height 1.0 to 15.0</li>
                <li>Flag Poles: Five vertical poles growing upward simultaneously</li>
            </ul>
        </li>
        <li><strong>Purpose:</strong> Verify both Canvas2D and Canvas3D receive animation events correctly and render smoothly.</li>
        <li><strong>Expected:</strong> All animations run for 5 seconds. Boxes move, pipes grow, flag poles extend.</li>
    </ul>
</div>
