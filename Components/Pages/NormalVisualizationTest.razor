@page "/normal-test"
@using BlazorThreeJS.Maths
@using FoundryBlazor.Shape
@using Three2025.Apprentice
@using Three2025.Services.Visualization
@using FoundryBlazor.Shared
@inherits NormalVisualizationTestBase

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <h3>🧭 Universal Geometry Face Normal Visualization</h3>
            <p>Testing face normals with any FoShape3D objects using UniversalSnapEngine</p>
            
            <Canvas3DComponent SceneName="NormalTest" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>🎛️ Test Controls</h5>
                </div>
                <div class="card-body">
                    
                    <!-- Basic Controls -->
                    <div class="mb-3">
                        <h6>Create Test Box</h6>
                        <div class="row">
                            <div class="col-4">
                                <label>Width:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="BoxWidth" step="0.1" min="0.1" />
                            </div>
                            <div class="col-4">
                                <label>Height:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="BoxHeight" step="0.1" min="0.1" />
                            </div>
                            <div class="col-4">
                                <label>Depth:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="BoxDepth" step="0.1" min="0.1" />
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm mt-2" @onclick="CreateTestBox">
                            Create Box
                        </button>
                    </div>

                    <!-- Position Controls -->
                    <div class="mb-3">
                        <h6>Position</h6>
                        <div class="row">
                            <div class="col-4">
                                <label>X:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="PosX" step="0.1" />
                            </div>
                            <div class="col-4">
                                <label>Y:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="PosY" step="0.1" />
                            </div>
                            <div class="col-4">
                                <label>Z:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="PosZ" step="0.1" />
                            </div>
                        </div>
                        <button class="btn btn-secondary btn-sm mt-2" @onclick="UpdatePosition">
                            Update Position
                        </button>
                    </div>

                    <!-- Rotation Controls -->
                    <div class="mb-3">
                        <h6>Rotation (degrees)</h6>
                        <div class="row">
                            <div class="col-4">
                                <label>Rx:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="RotX" step="15" />
                            </div>
                            <div class="col-4">
                                <label>Ry:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="RotY" step="15" />
                            </div>
                            <div class="col-4">
                                <label>Rz:</label>
                                <input type="number" class="form-control form-control-sm" 
                                       @bind="RotZ" step="15" />
                            </div>
                        </div>
                        <button class="btn btn-warning btn-sm mt-2" @onclick="UpdateRotation">
                            Update Rotation
                        </button>
                    </div>

                    <!-- Normal Visualization -->
                    <div class="mb-3">
                        <h6>Normal Visualization</h6>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" 
                                   @bind="ShowNormals" @bind:after="ToggleNormals" />
                            <label class="form-check-label">Show Face Normals</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" 
                                   @bind="ShowFaces" @bind:after="ToggleFaces" />
                            <label class="form-check-label">Show Face Planes</label>
                        </div>
                        <div class="mt-2">
                            <label>Normal Length:</label>
                            <input type="number" class="form-control form-control-sm" 
                                   @bind="NormalLength" @bind:after="UpdateNormals" step="0.1" min="0.1" max="5.0" />
                        </div>
                    </div>

                    <!-- Quick Tests -->
                    <div class="mb-3">
                        <h6>Quick Tests</h6>
                        <button class="btn btn-info btn-sm me-2 mb-2" @onclick="TestNoRotation">
                            No Rotation
                        </button>
                        <button class="btn btn-info btn-sm me-2 mb-2" @onclick="Test45Degree">
                            45° Y Rotation
                        </button>
                        <button class="btn btn-info btn-sm me-2 mb-2" @onclick="Test90Degree">
                            90° Y Rotation
                        </button>
                        <button class="btn btn-danger btn-sm mb-2" @onclick="ClearAll">
                            Clear All
                        </button>
                    </div>

                </div>
            </div>

            <!-- Status Panel -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6>📊 Status</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        @StatusMessage
                    </div>
                    
                    @if (TestBox != null)
                    {
                        <div class="small">
                            <strong>Face Information:</strong><br/>
                            @foreach (var face in UniversalSnapEngine.GetAllFaces(TestBox))
                            {
                                <div>
                                    <strong>@face.Name:</strong> 
                                    Center(@face.Center.X.ToString("F2"),@face.Center.Y.ToString("F2"),@face.Center.Z.ToString("F2"))
                                    Normal(@face.Normal.X.ToString("F2"),@face.Normal.Y.ToString("F2"),@face.Normal.Z.ToString("F2"))
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
