@page "/matrix-orientation-test"

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D

@using FoundryBlazor.Shared
@using FoundryBlazor.Shape
@using BlazorThreeJS.Viewers
@using BlazorThreeJS.Maths

<h3>Matrix Orientation Test Page</h3>

<div class="d-flex">
    <Canvas3DComponent SceneName="MatrixOrientationScene" @ref="Canvas3DReference" CanvasWidth="800" CanvasHeight="800" />
    <div class="controls-panel" style="margin-left: 10px; width: 350px; overflow-y: auto; max-height: 1000px;">
        <h4>Preset Orientations</h4>
        <div class="preset-buttons">
            <button class="btn btn-outline-primary" @onclick="() => ApplyPreset(0)">Rotate X 90°</button>
            <button class="btn btn-outline-primary" @onclick="() => ApplyPreset(1)">Rotate Y 90°</button>
            <button class="btn btn-outline-primary" @onclick="() => ApplyPreset(2)">Rotate Z 90°</button>
            <button class="btn btn-outline-primary" @onclick="() => ApplyPreset(3)">Combined XYZ</button>
            <button class="btn btn-outline-secondary" @onclick="RunAllPresets">Run All Presets</button>
        </div>
        <h4>Current Matrix</h4>
        @if (CurrentMatrix != null)
        {
            <table class="table table-sm table-bordered">
                @for (int i = 0; i < 4; i++)
                {
                    <tr>
                        @for (int j = 0; j < 4; j++)
                        {
                            <td>@String.Format("{0:F2}", CurrentMatrix[i * 4 + j])</td>
                        }
                    </tr>
                }
            </table>
        }
        <div style="margin-top:10px;">
            <span class="text-muted">Matrix updates automatically with each preset orientation.</span>
        </div>
    </div>
</div>

<style>
    .controls-panel {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    .preset-buttons {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 10px;
    }
    .d-flex {
        gap: 20px;
    }
</style>
