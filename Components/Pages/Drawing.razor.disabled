

@page "/drawing"

@namespace Three2025.Components.Pages
@inherits DrawingBase
@rendermode InteractiveServer

<PageTitle>Drawing</PageTitle>
<h2>This page renders using the Canvas3DComponent for 3D shapes and models</h2>



<div class="d-flex">
    <Canvas3DComponent SceneName="Drawing3D" @ref="Canvas3DReference" CanvasWidth="@CanvasWidth" CanvasHeight="@CanvasHeight"  />
    
    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" style="margin-left: 10px;">
        <h4>3D Models</h4>
        <button class="btn btn-primary" @onclick="OnAddTRex">Add T-Rex</button>
        <button class="btn btn-primary" @onclick="DoAxisTest">Add Axis</button>
        <button class="btn btn-primary" @onclick="OnAddJet">Add Jet</button>
        <button class="btn btn-primary" @onclick="OnAddPorsche">Add Porsche</button>
        
        <h4>3D Geometry</h4>
        <button class="btn btn-success" @onclick="OnAddGeom">Add Random Geometry</button>
        <button class="btn btn-success" @onclick="AddBoxToStage">Add Box to Stage</button>
        <button class="btn btn-success" @onclick="AddConeToArena">Add Cone to Arena</button>
        
        <h4>3D Text & Advanced</h4>
        <button class="btn btn-info" @onclick="OnAddText">Add 3D Text</button>
        <button class="btn btn-info" @onclick="OnRenderTube">Render Tube Geometry</button>
        
        <h4>Scene Control</h4>
        <button class="btn btn-danger" @onclick="OnClearScene">Clear Scene</button>
        
        <h4>2D Drawing Test</h4>
        <button class="btn btn-warning" @onclick="GoDrawing">Test 2D Shapes</button>
        
        <h4>Page Navigation</h4>
        <div style="max-height: 200px; overflow-y: auto;">
            @foreach(var page in AllPages())
            {
                <button class="btn btn-sm btn-outline-secondary mb-1" @onclick="() => GoToPage(page)">
                    @(page.Title ?? "Untitled Page")
                </button>
                <br />
            }
        </div>
    </RadzenStack>

</div>
