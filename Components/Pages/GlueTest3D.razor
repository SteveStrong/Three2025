@page "/gluetest3d"

@using FoundryWorldsAndDrawings.Shared
@using FoundryWorldsAndDrawings.Shape

@inherits GlueTest3DBase
@rendermode InteractiveServer

@namespace Three2025.Components.Pages

<h3>3D Glue Test - LEGO Block Stacking</h3>

<div style="margin-bottom: 15px; padding: 10px; background-color: #e3f2fd; border-radius: 5px;">
    <div style="margin-bottom: 10px;">
        <strong>Basic Tests:</strong><br/>
        <button class="btn btn-success" @onclick="CreateStackedTower">1. Create Boxes</button>
        <button class="btn btn-primary" @onclick="GlueGreenToRed">2. Toggle Green↔Red</button>
        <button class="btn btn-primary" @onclick="GlueBlueToGreen">3. Toggle Blue↔Green</button>
        <button class="btn btn-info" @onclick="StartAnimation">4. Animate</button>
        <button class="btn btn-danger" @onclick="StopAnimation">Stop</button>
        <button class="btn btn-warning" @onclick="Reset">Reset</button>
    </div>
    <div style="margin-bottom: 10px;">
        <strong>Advanced Connection Points:</strong><br/>
        <button class="btn btn-secondary" @onclick="TestFloatingGlue">Floating (offset 0.5)</button>
        <button class="btn btn-secondary" @onclick="TestSideGlue">Side Glue</button>
        <button class="btn btn-secondary" @onclick="TestCornerGlue">Corner Glue</button>
        <button class="btn btn-secondary" @onclick="TestEdgeGlue">Edge Glue</button>
    </div>
    <div>
        <strong>🎯 Rotation Alignment Tests:</strong><br/>
        <button class="btn btn-info" @onclick="TestAlignedTopGlue">Aligned Top ↓</button>
        <button class="btn btn-info" @onclick="TestAlignedSideGlue">Aligned Side →</button>
        <button class="btn btn-info" @onclick="TestAlignedBottomGlue">Aligned Bottom ↑</button>
        <button class="btn btn-info" @onclick="TestAlignedCornerGlue">Aligned Corner ⤡</button>
    </div>
    <div style="margin-top: 10px;">
        <strong>🔗 Dynamic Pipe Tests:</strong><br/>
        <button class="btn btn-warning" @onclick="CreatePipeBetweenBoxes">Single Pipe</button>
        <button class="btn btn-warning" @onclick="CreateMultiplePipes">Multiple Pipes</button>
        <button class="btn btn-warning" @onclick="TestPipeWithGlue">Pipe + Glue</button>
    </div>
</div>

<div style="display: flex; gap: 20px; margin-top: 20px;">
    <div style="flex: 1;">
        <h4>3D Canvas - Glued Objects</h4>
        <Canvas3DComponent SceneName="GlueTest3D" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight  />
    </div>

    <div style="flex: 0 0 350px;">
        <h4>Scene Hierarchy</h4>
        <div style="overflow: auto; background: #f5f5f5; padding: 10px; border-radius: 5px; max-height: 600px;">
            <ShapeTreeView />
        </div>
    </div>
</div>

<div style="margin-top: 20px; padding: 10px; background-color: #f5f5f5; border-radius: 5px;">
    <h5>Connection Point System:</h5>
    <ul>
        <li><strong>Face Centers (6):</strong> TopFaceCenter, BottomFaceCenter, LeftFaceCenter, RightFaceCenter, FrontFaceCenter, BackFaceCenter</li>
        <li><strong>Vertices (8):</strong> LeftTopFront, RightTopFront, LeftBottomFront, RightBottomFront, LeftTopBack, RightTopBack, LeftBottomBack, RightBottomBack</li>
        <li><strong>Edge Centers (12):</strong> TopFrontEdge, TopBackEdge, TopLeftEdge, TopRightEdge, BottomFrontEdge, BottomBackEdge, etc.</li>
        <li><strong>Offsets:</strong> Specify floating distance along snap direction (e.g., offset: 0.5 for hovering)</li>
        <li><strong>Snap Directions:</strong> Each point has a normal vector for proper alignment</li>
    </ul>
    <h5>Advanced Features:</h5>
    <ul>
        <li>✨ <strong>26 total connection points</strong> per box (6 faces + 8 corners + 12 edges)</li>
        <li>🎯 <strong>Snap directions</strong> ensure proper alignment at each point</li>
        <li>🌊 <strong>Floating offsets</strong> create spacing/hovering effects</li>
        <li>🔗 <strong>Dynamic glue/unglue</strong> works during animation</li>
        <li>⚡ <strong>Automatic propagation</strong> through Transform.OnChange hooks</li>
        <li>🔄 <strong>Rotation Alignment</strong> - child rotates to match parent's surface normal</li>
    </ul>
    <h5>Rotation Alignment:</h5>
    <ul>
        <li><strong>Aligned Top:</strong> Green box faces downward (opposite of up normal)</li>
        <li><strong>Aligned Side:</strong> Green box rotates 90° to face opposite of side normal</li>
        <li><strong>Aligned Bottom:</strong> Blue box flips upside down</li>
        <li><strong>Aligned Corner:</strong> Blue box rotates diagonally to match corner normal</li>
    </ul>
    <h5>Dynamic Pipes:</h5>
    <ul>
        <li><strong>Single Pipe:</strong> Creates one pipe between base and middle box</li>
        <li><strong>Multiple Pipes:</strong> Creates two pipes at different connection points (corner to corner, side to side)</li>
        <li><strong>Pipe + Glue:</strong> Demonstrates pipes updating automatically when boxes are glued and moved</li>
        <li>🔄 Pipes automatically recompute routing as objects move during animation</li>
        <li>📏 Uses orthogonal routing (step pattern) for cleaner visualization</li>
    </ul>
</div>
