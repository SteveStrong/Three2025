@page "/knmodel-animation"

@using FoundryWorldsAndDrawings.Solutions
@using FoundryWorldsAndDrawings.Shared
@using FoundryWorldsAndDrawings.Shape

@rendermode InteractiveServer

@namespace Three2025.Components.Pages

<h3>KnModel Animation Test - Animation Loop Event Experiment</h3>

<div style="margin-bottom: 15px; padding: 10px; background-color: #e3f2fd; border-radius: 5px; display: flex; justify-content: space-between; align-items: center; flex-wrap: nowrap; gap: 20px;">
    <div style="display: flex; gap: 10px; align-items: center; flex-shrink: 0;">
        <button class="btn btn-success" @onclick="StartAnimation">Start Animation</button>
        <button class="btn btn-warning" @onclick="PauseAnimation">Pause</button>
        <button class="btn btn-info" @onclick="ResumeAnimation">Resume</button>
        <button class="btn btn-secondary" @onclick="ResetTest">Reset</button>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; padding: 0 15px; background-color: #fff3cd; border-radius: 5px; flex-shrink: 0;">
        <span style="font-weight: bold;">Animation State:</span>
        <div style="font-family: monospace; font-size: 14px; font-weight: bold; padding: 5px 10px; background-color: #fff; border-radius: 3px; margin-left: 10px;">
            @AnimationFrameBus.GetAnimationState()
        </div>
    </div>
    <div style="font-family: monospace; font-size: 16px; font-weight: bold; flex-shrink: 0;">
        <span style="margin-right: 20px;">FPS: @AnimationFrameBus.GetCurrentFps().ToString("F1")</span>
        <span style="margin-right: 20px;">Tick: @AnimationFrameBus.GetCurrentTick()</span>
    </div>
</div>

<div style="display: flex; gap: 15px; margin-top: 15px; height: calc(100vh - 160px);">
    @* Left Panel - 3D Canvas *@
    <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column;">
        <h5 style="margin-bottom: 8px;">3D Canvas</h5>
        <div style="margin-bottom: 8px;">
            <button class="btn btn-primary btn-sm" @onclick="AddAnimatedBox">Add Box</button>
            <button class="btn btn-success btn-sm" @onclick="AddRotatingGroup">Add Group</button>
            <button class="btn btn-danger btn-sm" @onclick="ClearScene">Clear</button>
        </div>
        <div style="flex: 1; border: 1px solid #ccc; border-radius: 5px; overflow: hidden;">
            <Canvas3DComponent SceneName="KnModelTest3D" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
        </div>
    </div>

    @* Second Panel - 2D Canvas *@
    <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column;">
        <h5 style="margin-bottom: 8px;">2D Canvas</h5>
        <div style="margin-bottom: 8px;">
            <button class="btn btn-outline-secondary btn-sm" disabled>2D shapes coming soon</button>
        </div>
        <div style="flex: 1; border: 1px solid #ccc; border-radius: 5px; overflow: hidden;">
            <Canvas2DComponent SceneName="KnModelTest2D" @ref="Canvas2DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
        </div>
    </div>

    @* Center Panel - KnModel Tree (MOST IMPORTANT) *@
    <div style="flex: 1.5; min-width: 400px; display: flex; flex-direction: column;">
        <h5 style="margin-bottom: 8px; color: #1976d2;">📊 KnModel Tree View</h5>
        <div style="margin-bottom: 8px; flex-shrink: 0;">
            <button class="btn btn-primary btn-sm" @onclick="RefreshTree">Refresh Tree</button>
            <button class="btn btn-warning btn-sm" @onclick="AddChildComponent">Add KnComponent</button>
        </div>
        <div style="flex: 1; overflow: auto; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); padding: 15px; border-radius: 8px; border: 2px solid #1976d2; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <ShapeTreeItem 
                Items="@GetModelTreeNodes()" 
                OnSelect="OnTreeNodeSelected">
            </ShapeTreeItem>
        </div>
    </div>

    @* Right Panel - Event Log *@
    <div style="flex: 0 0 300px; display: flex; flex-direction: column;">
        <h5 style="margin-bottom: 8px;">Animation Event Log</h5>
        <div style="margin-bottom: 8px; flex-shrink: 0;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearEventLog">Clear Log</button>
            <label style="margin-left: 10px; font-size: 12px;">
                <input type="checkbox" @bind="_logAllEvents" /> Log All
            </label>
        </div>
        <div style="flex: 1; overflow: auto; background: #1e1e1e; color: #d4d4d4; padding: 10px; border-radius: 5px; font-family: 'Consolas', monospace; font-size: 11px;">
            @foreach (var log in _eventLogs.TakeLast(50).Reverse())
            {
                <div style="margin-bottom: 4px; border-bottom: 1px solid #333; padding-bottom: 4px;">
                    <span style="color: @GetLogColor(log.Type);">[@log.Type]</span>
                    <span style="color: #808080;">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <br/>
                    <span>@log.Message</span>
                </div>
            }
        </div>
    </div>
</div>

