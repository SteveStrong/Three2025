@page "/chat-test"
@namespace Three2025.Components.Pages
@using Microsoft.Extensions.AI

@rendermode InteractiveServer

<div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">
    <!-- Header -->
    <div style="padding: 1rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h2 style="margin: 0 0 0.5rem 0; font-size: 1.5rem;">🤖 Chat Orchestrator Test</h2>
        <div style="font-size: 0.9rem; opacity: 0.95;">
            <strong>🔧 Tools:</strong> @toolCount &nbsp;&nbsp;
            <strong>🤖 Agents:</strong> @string.Join(", ", availableAgents)
        </div>
    </div>

    <!-- Main Content Area: Chat (3/5) + Activity Log (2/5) -->
    <div style="flex: 1; display: flex; overflow: hidden;">
        <!-- Chat Messages (3/5 width) -->
        <div @ref="chatContainer" style="flex: 3; background: #f8f9fa; padding: 1rem 2rem; overflow-y: auto; border-right: 2px solid #ddd;">
            @foreach (var msg in conversationHistory)
            {
                <div style="margin-bottom: 1.5rem; display: flex; justify-content: @(msg.Role == ChatRole.User ? "flex-end" : "flex-start");">
                    <div style="max-width: 70%; padding: 1rem; border-radius: 12px; background: @(msg.Role == ChatRole.User ? "#667eea" : "#ffffff"); color: @(msg.Role == ChatRole.User ? "white" : "#333"); box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem; opacity: 0.9;">
                            @(msg.Role == ChatRole.User ? "You" : currentAgent)
                        </div>
                        <div>@((MarkupString)msg.Text)</div>
                    </div>
                </div>
            }
            
            @if (isProcessing && !string.IsNullOrEmpty(streamingResponse))
            {
                <div style="margin-bottom: 1.5rem; display: flex; justify-content: flex-start;">
                    <div style="max-width: 70%; padding: 1rem; border-radius: 12px; background: #ffffff; color: #333; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem; opacity: 0.9;">
                            @currentAgent
                        </div>
                        <div>@((MarkupString)streamingResponse)<span style="animation: blink 1s infinite;">▋</span></div>
                    </div>
                </div>
            }
            else if (isProcessing)
            {
                <div style="padding: 1rem; text-align: center; color: #666;">
                    <em>🤔 @currentAgent is thinking...</em>
                </div>
            }
        </div>

        <!-- Activity Log Panel (2/5 width) -->
        <div @ref="logContainer" style="flex: 2; background: #1e1e1e; color: #d4d4d4; padding: 1rem; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.85rem; scroll-behavior: smooth;">
            <div style="position: sticky; top: 0; background: #1e1e1e; padding-bottom: 0.5rem; border-bottom: 1px solid #3e3e3e; margin-bottom: 0.5rem; z-index: 10;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <strong style="color: #4ec9b0;">📊 Activity Log</strong>
                    <div style="display: flex; gap: 0.5rem;">
                        <button @onclick="ToggleAutoScroll" style="background: @(autoScrollLogs ? "#264f78" : "#3e3e3e"); color: #d4d4d4; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            @(autoScrollLogs ? "🔄 Auto" : "⏸️ Manual")
                        </button>
                        <button @onclick="ClearLogs" style="background: #3e3e3e; color: #d4d4d4; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            Clear
                        </button>
                    </div>
                </div>
            </div>
            
            @foreach (var log in activityLogs)
            {
                <div style="margin-bottom: 0.75rem; padding: 0.5rem; background: @GetLogBackgroundColor(log.Type); border-left: 3px solid @GetLogBorderColor(log.Type); border-radius: 4px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                        <span style="color: @GetLogColor(log.Type); font-weight: 600;">@GetLogIcon(log.Type) @log.Type</span>
                        <span style="color: #808080; font-size: 0.75rem;">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                    </div>
                    <div style="color: #d4d4d4; word-wrap: break-word;">@log.Message</div>
                    @if (!string.IsNullOrEmpty(log.Details))
                    {
                        <div style="color: #808080; font-size: 0.8rem; margin-top: 0.25rem; font-style: italic;">@log.Details</div>
                    }
                </div>
            }
            
            @if (!activityLogs.Any())
            {
                <div style="color: #808080; text-align: center; margin-top: 2rem; font-style: italic;">
                    No activity yet. Start a conversation to see logs.
                </div>
            }
            
            <div @ref="logScrollAnchor"></div>
        </div>
    </div>

    <!-- Input Area -->
    <div style="padding: 1rem 2rem; background: white; border-top: 1px solid #ddd; box-shadow: 0 -2px 8px rgba(0,0,0,0.05);">
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
            <input type="text" 
                   @bind="userInput" 
                   @bind:event="oninput"
                   @onkeydown="HandleKeyPress"
                   placeholder="Ask about geometry, clocks, 3D shapes, or animations..."
                   style="flex: 1; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1rem;"
                   disabled="@isProcessing" />
            <button @onclick="SendMessage" 
                    disabled="@(isProcessing || string.IsNullOrWhiteSpace(userInput))"
                    style="padding: 0.75rem 2rem; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem; font-weight: 600; transition: all 0.2s;">
                @(isProcessing ? "Sending..." : "Send")
            </button>
        </div>

        <!-- Quick Test Buttons -->
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button @onclick='() => QuickTest("Create a red Box width:1, Height:2, Depth:3, at position X:4, y:2, Z:5")' style="padding: 0.5rem 1rem; background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">
                💡 Test geometry Tool
            </button>

            <button @onclick="ShowToolList" style="padding: 0.5rem 1rem; background: #e7e7ff; border: 1px solid #6c63ff; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">
                🔍 Show All Tools
            </button>
            <button @onclick="ClearChat" style="padding: 0.5rem 1rem; background: #f8d7da; border: 1px solid #dc3545; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">
                🗑️ Clear Chat
            </button>
        </div>
    </div>
</div>

<style>
    @@keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }
</style>
