@page "/clock"

@namespace Three2025.Components.Pages
@inherits ClockBase
@rendermode InteractiveServer

<PageTitle>Clock</PageTitle>
<h2>Canvas3DComponent and calls API's top create Clock</h2>
<div style="padding: 10px; background-color: #e8f5e9; margin-bottom: 10px; border-radius: 5px;">
    <strong>FPS:</strong> @_currentFps.ToString("F1") &nbsp;&nbsp;&nbsp; <strong>Tick:</strong> @_currentTick
</div>

<style>
    .canvas-container {
        border: 1px solid #ccc;
        background-color: #f0f0f0;
    }
</style>

<div class="d-flex">

   <div class="canvas-container">
       <Canvas3DComponent SceneName="Clock3D" @ref="Canvas3DReference" CanvasWidth=@CanvasWidth CanvasHeight=@CanvasHeight />
   </div>
     <ShapeTreeView/>
    <AIChat/>
    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" style="margin-left: 10px;">
        <h4>Testing the API's</h4>
        <button class="btn btn-primary" @onclick="DoAddTextToArena">Add Text to Arena</button>
        <button class="btn btn-primary" @onclick="DoAddBoxGLBToArena">Add BoxAnimated to Arena</button>
        <h4>Scene Objects</h4>
        <button class="btn btn-primary" @onclick="DoAddTRexToArena">T-Rex to Arena</button>
        <button class="btn btn-primary" @onclick="DoRequestAxisToScene">Request Axis to Scene</button>

        <button class="btn btn-primary" @onclick="DoClockFaceOnScene">Clock Face to Scene</button>
        <button class="btn btn-primary" @onclick="DoRequestAddSubToArena">Add Submarine to Arena</button>

                
        <h4>Add to Arena</h4>
        <button class="btn btn-primary" @onclick="DoRunClock">Arena Clock</button>
        <button class="btn btn-primary" @onclick="DoAddTRISOCToArena">TRISOC to Arena</button>
       @* 
        <button class="btn btn-primary" @onclick="DoAddBoxToScene">Box to Scene</button>
        <button class="btn btn-primary" @onclick="DoAddTubeToScene">Tube to Scene</button>
        <button class="btn btn-primary" @onclick="DoAddConeToScene">Cone to Scene</button>

        
        <h4>Add to Stage</h4>
        <button class="btn btn-primary" @onclick="DoAddGeomToStage">Geometry to Stage</button>


        <button class="btn btn-primary" @onclick="DoAddTextArena">Add Text</button>

        <h4>Add to World</h4>
        <button class="btn btn-primary" @onclick="OnAddCage">Add Cage</button>
        <button class="btn btn-primary" @onclick="DoAddTriSocGeometry">TriSoc</button>
        <button class="btn btn-primary" @onclick="DoAddPorscheToArena">Porsche</button> *@
    </RadzenStack>

</div>
