@page "/diagram-viewer"
@namespace Three2025.Components.Pages
@rendermode InteractiveServer
@using FoundryMentorModeler.Model
@using FoundryMentorModeler.Diagram
@// DISABLED: using Plugin_710.Model
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Radzen.Blazor
@inherits DiagramViewerBase

<PageTitle>Diagram Viewer</PageTitle>

<style>
    .diagram-container {
        width: 100%;
        height: 100%;
        border: 1px solid #ccc;
        background: white;
        position: relative;
    }
    
    .canvas-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    
    .loading-content {
        text-align: center;
    }
</style>

<div class="container-fluid p-3" style="height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Header -->
    <div class="card mb-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
        <div class="card-body p-3">
            <h3 class="mb-2">📐 Diagram Viewer - Modern Implementation</h3>
            <p class="mb-0 small">Following Scenario Chat diagram pattern with proper RenderEditor flow</p>
        </div>
    </div>

    <!-- Control Panel -->
    <div class="card mb-3">
        <div class="card-body p-2">
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" @onclick="CreateSystemDiagram" disabled="@_isLoading">
                    @if (_isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    🔷 Create System Diagram
                </button>
                <button class="btn btn-success" @onclick="CreateCircuitDiagram" disabled="@_isLoading">
                    ⚡ Create Circuit Diagram
                </button>
                <button class="btn btn-info" @onclick="AddSystemBlock" disabled="@(_model == null || _diagram == null || _isLoading)">
                    ➕ Add System Block
                </button>
                <button class="btn btn-warning" @onclick="AddCircuitNode" disabled="@(_model == null || _diagram == null || _isLoading)">
                    🔌 Add Circuit Node
                </button>
                <button class="btn btn-danger" @onclick="ClearDiagram" disabled="@(_diagram == null || _isLoading)">
                    🗑️ Clear
                </button>
                <span class="ms-3">Nodes: @_nodeCount | Links: @_linkCount</span>
            </div>
        </div>
    </div>

    <!-- Layout Control Panel -->
    <div class="card mb-3">
        <div class="card-body p-2">
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <span class="fw-bold">🗂️ Layout:</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="() => ApplyLayout(Plugin_710.Model.LayoutType_710.Horizontal)" 
                    disabled="@(_model == null || _diagram == null || _isLoading)">
                    ↔️ Horizontal Tree
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="() => ApplyLayout(Plugin_710.Model.LayoutType_710.Vertical)" 
                    disabled="@(_model == null || _diagram == null || _isLoading)">
                    ↕️ Vertical Tree
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyLayout(Plugin_710.Model.LayoutType_710.None)" 
                    disabled="@(_model == null || _diagram == null || _isLoading)">
                    🔄 Reset Layout
                </button>
            </div>
        </div>
    </div>

    @if (_statusMessage != null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div style="height: calc(100vh - 280px); overflow: hidden;">
        <RadzenSplitter Orientation="Orientation.Horizontal" style="height: 100%;">
            
            <!-- Left Side: Diagram Canvas -->
            <RadzenSplitterPane Size="70%" Min="50%" Max="85%">
                <div style="display: flex; flex-direction: column; height: 100%; background: #ecf0f1;">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">📊 Diagram Canvas</h5>
                    </div>
                    <div class="diagram-container" style="flex: 1;">
                        @if (_isLoading)
                        {
                            <!-- Loading overlay with progress indicator -->
                            <div class="canvas-loading-overlay">
                                <div class="loading-content">
                                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <h4>@_loadingMessage</h4>
                                </div>
                            </div>
                        }
                        
                        @if (_diagram != null)
                        {
                            <!-- CascadingValue with IsFixed for performance -->
                            <CascadingValue Value="_diagram" IsFixed="true">
                                <DiagramCanvas>
                                    <Widgets>
                                        <SelectionBoxWidget />
                                        <GridWidget Size="50" Mode="GridMode.Line" BackgroundColor="white" />
                                        <NavigatorWidget Width="200" Height="120" 
                                            Class="border border-dark bg-white position-absolute"
                                            Style="bottom: 15px; right: 15px; z-index: 10;" />
                                    </Widgets>
                                </DiagramCanvas>
                            </CascadingValue>
                        }
                        else if (!_isLoading)
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <div class="text-center">
                                    <i class="bi bi-diagram-3" style="font-size: 4rem;"></i>
                                    <p class="mt-3">Click "Create System Diagram" or "Create Circuit Diagram" to begin</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </RadzenSplitterPane>
            
            <!-- Right Side: Model Tree -->
            <RadzenSplitterPane Size="30%" Min="15%" Max="50%">
                <div style="display: flex; flex-direction: column; height: 100%; background: white;">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">📦 Model Components</h5>
                        <button class="btn btn-sm btn-light" @onclick="RefreshTree">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>
                    <div style="flex: 1; overflow-y: auto; padding: 10px;">
                        @if (_model != null)
                        {
                            <MentorTreeView />
                        }
                        else
                        {
                            <p class="text-muted text-center mt-4">No model created yet</p>
                        }
                    </div>
                </div>
            </RadzenSplitterPane>
            
        </RadzenSplitter>
    </div>
</div>
