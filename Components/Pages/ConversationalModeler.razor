@page "/conversational-modeler"
@namespace Three2025.Components.Pages
@using FoundryMentorModeler.Model
@using FoundryMentorModeler.Shared
@using FoundryWorldsAndDrawings.Shape
@using FoundryWorldsAndDrawings.Solutions
@using FoundryWorldsAndDrawings.Shared
@using Three2025.Components.Shared
@using Three2025.Components.Shared.Testing
@using Three2025.Components.Shared.Chat
@using Three2025.Apprentice
@using Three2025.Models.Chat
@using Three2025.Services.Chat
@using Microsoft.Extensions.AI
@using AIChatMessage = Microsoft.Extensions.AI.ChatMessage
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Conversational Modeler</PageTitle>

<div style="height: calc(100vh - 2rem); overflow: hidden;">
    <RadzenSplitter Orientation="Orientation.Horizontal" style="height: 100%;">
        <!-- Left Panel: Chat Window -->
        <RadzenSplitterPane Size="50%" Min="30%" Max="70%">
            <div style="display: flex; flex-direction: column; height: 100%; background: white;">
                <ChatPanel Messages="chatMessages" 
                           OnSendMessage="SendChatMessage"
                           @bind-InputValue="@chatInputValue"
                           InputPlaceholder="Describe your engineering problem and I'll build a knowledge model to solve it..."
                           CurrentAgent="@currentAgent"
                           IsProcessing="isProcessingChat">
                    <HeaderContent>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem;">
                            <div style="padding: 0.5rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 6px; text-align: center; font-weight: 600; font-size: 0.85rem;">
                                🗣️ Conversational Modeler Assistant
                            </div>
                            <div style="display: flex; gap: 0.25rem; flex-wrap: wrap; font-size: 0.75rem;">
                                <span style="padding: 0.25rem 0.5rem; background: #e3f2fd; border-radius: 4px; color: #1976d2;">
                                    📊 Models
                                </span>
                                <span style="padding: 0.25rem 0.5rem; background: #fff3e0; border-radius: 4px; color: #f57c00;">
                                    🧮 Calculations
                                </span>
                                <span style="padding: 0.25rem 0.5rem; background: #f3e5f5; border-radius: 4px; color: #7b1fa2;">
                                    📐 Engineering
                                </span>
                            </div>
                            
                            <!-- Test Sequence Selector -->
                            <TestSequenceSelector OnSequenceSelected="HandleTestSequenceSelected"
                                                 IsDisabled="isProcessingChat"
                                                 ShowDescription="true" />
                        </div>
                    </HeaderContent>
                    <FooterActions>
                        <button @onclick='() => QuickTest("Calculate beam deflection for a 10 ft steel beam with 500 lb center load")' style="padding: 0.25rem 0.5rem; background: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            🔨 Beam Deflection
                        </button>
                        <button @onclick='() => QuickTest("Create a heat transfer model for a concrete wall")' style="padding: 0.25rem 0.5rem; background: #ff9800; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            🌡️ Heat Transfer
                        </button>
                        <button @onclick='() => QuickTest("Design a voltage divider circuit")' style="padding: 0.25rem 0.5rem; background: #2196f3; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            ⚡ Circuit Design
                        </button>
                        <button @onclick='() => QuickTest("Create a truss analysis model")' style="padding: 0.25rem 0.5rem; background: #9c27b0; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            🏗️ Truss Analysis
                        </button>
                        <button @onclick='() => QuickTest("List all available tools and functions")' style="padding: 0.25rem 0.5rem; background: #17a2b8; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.75rem; font-weight: 500;">
                            🔍 List Tools
                        </button>
                        <button @onclick="ClearModel" style="padding: 0.25rem 0.5rem; background: #f8d7da; border: 1px solid #dc3545; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                            🗑️ Clear Model
                        </button>
                    </FooterActions>
                </ChatPanel>
            </div>
        </RadzenSplitterPane>

        <!-- Right Panel: Model & Activity Explorer -->
        <RadzenSplitterPane Size="50%" Min="30%" Max="70%">
            <div style="display: flex; flex-direction: column; height: 100%; background: white;">
                <div style="padding: 0.75rem; background: #2c3e50; color: white;">
                    <h3 style="margin: 0; font-size: 1rem;">🏗️ Model Explorer</h3>
                </div>
                <ul class="nav nav-tabs" role="tablist" style="flex-shrink: 0; margin: 0; border-bottom: 2px solid #dee2e6;">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTreeTab == "model" ? "active" : "")" 
                                @onclick="@(() => _activeTreeTab = "model")" 
                                type="button" role="tab"
                                style="font-size: 0.85rem;">
                            📊 Model
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTreeTab == "parameters" ? "active" : "")" 
                                @onclick="@(() => _activeTreeTab = "parameters")" 
                                type="button" role="tab"
                                style="font-size: 0.85rem;">
                            📋 Parameters
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTreeTab == "activity" ? "active" : "")" 
                                @onclick="@(() => _activeTreeTab = "activity")" 
                                type="button" role="tab"
                                style="font-size: 0.85rem;">
                            📊 Activity
                        </button>
                    </li>
                </ul>
                <div style="flex: 1; overflow: auto; padding: 1rem; background: white;">
                    @if (_activeTreeTab == "model")
                    {
                        @if (CurrentModel == null)
                        {
                            <div style="color: #808080; text-align: center; margin-top: 2rem; font-style: italic; font-size: 0.8rem;">
                                No model created yet.<br/>
                                Start a conversation to build a model!
                            </div>
                        }
                        else
                        {
                            <MentorTreeView/>
                        }
                    }
                    else if (_activeTreeTab == "parameters")
                    {
                        @if (SelectedComponent != null)
                        {
                            <div class="parameter-grid">
                                <div class="grid-header">Name</div>
                                <div class="grid-header">Value</div>
                                <div class="grid-header">Formula</div>
                                
                                @foreach (var param in GetParameters(SelectedComponent))
                                {
                                    <div class="param-name">@param.Name</div>
                                    <div class="param-value @(param.IsCalculated ? "calculated" : "")">
                                        @param.DisplayValue
                                    </div>
                                    <div class="param-formula">@param.Formula</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="color: #808080; text-align: center; margin-top: 2rem; font-style: italic; font-size: 0.8rem;">
                                Select a component to view parameters
                            </div>
                        }
                    }
                    else if (_activeTreeTab == "activity")
                    {
                        <div @ref="logContainer" style="background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; height: 100%; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.8rem; margin: -1rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #3e3e3e;">
                                <button @onclick="ToggleAutoScroll" style="background: @(autoScrollLogs ? "#264f78" : "#3e3e3e"); color: #d4d4d4; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; font-size: 0.7rem;">
                                    @(autoScrollLogs ? "🔄 Auto" : "⏸️ Manual")
                                </button>
                                <button @onclick="ClearActivityLogs" style="background: #3e3e3e; color: #d4d4d4; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; font-size: 0.7rem;">
                                    Clear
                                </button>
                            </div>
                            
                            @foreach (var log in ActivityLog)
                            {
                                <div style="margin-bottom: 0.5rem; padding: 0.4rem; background: @GetLogBackgroundColor(log.Level); border-left: 2px solid @GetLogBorderColor(log.Level); border-radius: 3px;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.2rem;">
                                        <span style="color: @GetLogColor(log.Level); font-weight: 600; font-size: 0.75rem;">@GetLogIcon(log.Level) @log.Level</span>
                                        <span style="color: #808080; font-size: 0.7rem;">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                    </div>
                                    <div style="color: #d4d4d4; word-wrap: break-word; font-size: 0.75rem;">@log.Message</div>
                                </div>
                            }
                            
                            @if (!ActivityLog.Any())
                            {
                                <div style="color: #808080; text-align: center; margin-top: 2rem; font-style: italic; font-size: 0.8rem;">
                                    No activity yet. Start a conversation to see API calls and model operations.
                                </div>
                            }
                            
                            <div @ref="logScrollAnchor"></div>
                        </div>
                    }
                </div>
            </div>
        </RadzenSplitterPane>
    </RadzenSplitter>
</div>

