@page "/geometry-debug"

@using FoundryWorldsAndDrawings.Shared
@using FoundryWorldsAndDrawings.Shape
@using FoundryMentorModeler.Model

@rendermode InteractiveServer

<style>
    .canvas3d-fill {
        width: 100% !important;
        height: 400px !important;
    }
    .canvas3d-fill canvas {
        width: 100% !important;
        height: 100% !important;
    }
</style>

<PageTitle>Geometry Debug Test</PageTitle>

<div class="container-fluid">
    <h3>Geometry Debug Test</h3>
    <p class="text-muted">Fine-grained control to trace geometry lifecycle when parameters change</p>
    
    <div class="row">
        <!-- Left: Controls -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">Parameter Controls</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label"><strong>Geometry Type</strong></label>
                        <div class="btn-group d-block">
                            <button class="btn @(_currentGeomType == "Box" ? "btn-primary" : "btn-outline-primary") btn-sm" 
                                    @onclick="@(() => SetGeometryType("Box"))">Box</button>
                            <button class="btn @(_currentGeomType == "Sphere" ? "btn-primary" : "btn-outline-primary") btn-sm" 
                                    @onclick="@(() => SetGeometryType("Sphere"))">Sphere</button>
                            <button class="btn @(_currentGeomType == "Cylinder" ? "btn-primary" : "btn-outline-primary") btn-sm" 
                                    @onclick="@(() => SetGeometryType("Cylinder"))">Cylinder</button>
                        </div>
                        <div class="small text-muted mt-1">Current: @_currentGeomType</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Color</strong></label>
                        <div class="btn-group d-block">
                            <button class="btn btn-sm" style="background-color: blue; color: white;" 
                                    @onclick="@(() => SetColor("Blue"))">Blue</button>
                            <button class="btn btn-sm" style="background-color: green; color: white;" 
                                    @onclick="@(() => SetColor("Green"))">Green</button>
                            <button class="btn btn-sm" style="background-color: red; color: white;" 
                                    @onclick="@(() => SetColor("Red"))">Red</button>
                        </div>
                        <div class="small text-muted mt-1">Current: @_currentColor</div>
                    </div>
                    
                    <hr />
                    
                    <div class="mb-3">
                        <label class="form-label">Width: @_width</label>
                        <input type="range" class="form-range" min="0.5" max="5" step="0.5" 
                               value="@_width" @onchange="OnWidthChanged" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Height: @_height</label>
                        <input type="range" class="form-range" min="0.5" max="5" step="0.5" 
                               value="@_height" @onchange="OnHeightChanged" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Depth: @_depth</label>
                        <input type="range" class="form-range" min="0.5" max="5" step="0.5" 
                               value="@_depth" @onchange="OnDepthChanged" />
                    </div>
                    
                    <hr />
                    <h6>Transform Position</h6>
                    
                    <div class="mb-3">
                        <label class="form-label">X Position: @_positionX</label>
                        <input type="range" class="form-range" min="-5" max="5" step="0.5" 
                               value="@_positionX" @onchange="OnXPositionChanged" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Y Position: @_positionY</label>
                        <input type="range" class="form-range" min="-5" max="5" step="0.5" 
                               value="@_positionY" @onchange="OnYPositionChanged" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Z Position: @_positionZ</label>
                        <input type="range" class="form-range" min="-5" max="5" step="0.5" 
                               value="@_positionZ" @onchange="OnZPositionChanged" />
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Utilities</div>
                <div class="card-body">
                    <button class="btn btn-danger btn-sm d-block w-100" @onclick="ClearStage">
                        Clear Stage
                    </button>
                </div>
            </div>

        </div>
        
        <!-- Middle: 3D Canvas -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">3D View - "GeomDebug3D"</div>
                <div class="card-body p-0 canvas3d-fill">
                    <Canvas3DComponent SceneName="GeomDebug3D" @ref="Canvas3DReference" />
                </div>
            </div>
        </div>
        
        <!-- Right: Model Tree and Event Log -->
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == "model" ? "active" : "")" 
                                    @onclick="@(() => _activeTab = "model")" 
                                    type="button" role="tab">
                                📊 Model
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == "shape" ? "active" : "")" 
                                    @onclick="@(() => _activeTab = "shape")" 
                                    type="button" role="tab">
                                🔷 Stage
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeTab == "log" ? "active" : "")" 
                                    @onclick="@(() => _activeTab = "log")" 
                                    type="button" role="tab">
                                📝 Log
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content" style="max-height: 600px; overflow-y: auto; padding-top: 10px;">
                        @if (_activeTab == "model")
                        {
                            <MentorTreeView/>
                        }
                        else if (_activeTab == "shape")
                        {
                            <ShapeTreeView/>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span><strong>Event Log</strong></span>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearLog">Clear</button>
                            </div>
                            <table class="table table-sm table-striped mb-0" style="font-size: 0.75rem;">
                                <tbody>
                                    @foreach (var log in _eventLogs.TakeLast(50).Reverse())
                                    {
                                        <tr class="@GetLogClass(log.Type)">
                                            <td style="width: 60px;">@log.Timestamp.ToString("HH:mm:ss")</td>
                                            <td style="width: 70px;"><strong>@log.Type</strong></td>
                                            <td>@log.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

