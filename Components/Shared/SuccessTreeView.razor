@using FoundryMentorModeler.Model
@using FoundryMentorModeler.Shared
@using FoundryRulesAndUnits.Models
@inherits ComponentBase

@namespace Three2025.Components.Shared

<style>
    .success-tree-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 0;
    }

    .success-tree-container ul {
        margin: 0;
        padding: 0;
    }
</style>

<div class="success-tree-container">
    <ul>
        <MentorTreeItem 
            Items="@RootItems" 
            Level="0"
            ShowSuccessBadges="true"
            OnSelect="@HandleSelect">
        </MentorTreeItem>
    </ul>
</div>

@code {
    [Parameter]
    public IEnumerable<ITreeNode>? RootItems { get; set; }

    [Parameter]
    public Action<ITreeNode>? OnSelect { get; set; }
    
    private void HandleSelect(ITreeNode item)
    {
        OnSelect?.Invoke(item);
    }
}
