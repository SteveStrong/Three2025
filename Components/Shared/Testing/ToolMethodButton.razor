@using Three2025.Models.Testing

<div style="margin-bottom: 0.75rem; background: white; border-radius: 6px; border: 1px solid @(_showDetails ? "#667eea" : "#dee2e6"); overflow: hidden; transition: all 0.2s;">
    <div style="display: flex;">
        <button @onclick="OnExecute" disabled="@IsExecuting"
                style="flex: 1; text-align: left; padding: 0.75rem; background: @(IsExecuting ? "#f8f9fa" : "white"); border: none; cursor: @(IsExecuting ? "wait" : "pointer"); transition: all 0.2s;">
            
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.2rem;">
                    @if (IsExecuting)
                    {
                        <span>⏳</span>
                    }
                    else
                    {
                        <span>▶️</span>
                    }
                </span>
                <div style="flex: 1;">
                    <div style="font-weight: 600; color: #2c3e50; margin-bottom: 0.25rem;">
                        @Method.MethodName
                    </div>
                    <div style="font-size: 0.85rem; color: #666;">
                        @Method.Description
                    </div>
                </div>
                @if (Method.Parameters.Any())
                {
                    <span style="background: #e3f2fd; color: #1976d2; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                        @Method.Parameters.Count param@(Method.Parameters.Count != 1 ? "s" : "")
                    </span>
                }
            </div>
        </button>
        
        @if (Method.Parameters.Any())
        {
            <button @onclick="ToggleDetails" 
                    style="padding: 0.75rem; background: @(_showDetails ? "#667eea" : "#f8f9fa"); color: @(_showDetails ? "white" : "#666"); border: none; border-left: 1px solid #dee2e6; cursor: pointer; transition: all 0.2s; font-size: 1rem;">
                @(_showDetails ? "▲" : "ℹ️")
            </button>
        }
    </div>
    
    @if (_showDetails && Method.Parameters.Any())
    {
        <div style="padding: 0.75rem; background: #f8f9fa; border-top: 1px solid #dee2e6; font-size: 0.8rem;">
            <div style="font-weight: 600; color: #667eea; margin-bottom: 0.5rem;">
                Parameters (LLM sees this):
            </div>
            @foreach (var param in Method.Parameters)
            {
                <div style="margin-bottom: 0.5rem; padding-left: 1rem;">
                    <span style="font-family: 'Consolas', monospace; color: #764ba2; font-weight: 600;">@param.Name</span>
                    <span style="color: #999;">: @param.Type</span>
                    @if (param.HasDefaultValue)
                    {
                        <span style="color: #28a745; font-size: 0.75rem;"> = @FormatDefaultValue(param.DefaultValue)</span>
                    }
                    @if (!string.IsNullOrEmpty(param.Description))
                    {
                        <div style="color: #666; font-style: italic; margin-top: 0.1rem;">
                            @param.Description
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    #nullable enable
    
    [Parameter] public ToolMethodMetadata Method { get; set; } = null!;
    [Parameter] public EventCallback OnExecute { get; set; }
    [Parameter] public bool IsExecuting { get; set; }

    private bool _showDetails = false;

    private void ToggleDetails()
    {
        _showDetails = !_showDetails;
    }

    private string FormatDefaultValue(object? value)
    {
        if (value == null) return "null";
        if (value is string s) return $"\"{s}\"";
        if (value is bool b) return b.ToString().ToLower();
        return value.ToString() ?? "null";
    }
}
