<div style="display: flex; flex-direction: column; height: 100%; background: white;">
    <!-- Header -->
    <div style="padding: 0.75rem 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex-shrink: 0;">
        <h4 style="margin: 0; font-size: 1.1rem;">🧪 @Title</h4>
        <div style="font-size: 0.85rem; opacity: 0.9; margin-top: 0.25rem;">
            @if (_toolMethods != null)
            {
                <span>@_toolMethods.Count tool methods discovered</span>
            }
            else
            {
                <span>Discovering tools...</span>
            }
        </div>
    </div>

    <!-- Tool Buttons -->
    <div style="flex: 1; overflow-y: auto; padding: 1rem; background: #f8f9fa;">
        @if (_isLoading)
        {
            <div style="text-align: center; padding: 2rem; color: #666;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">⏳</div>
                <div>Discovering tool methods...</div>
            </div>
        }
        else if (_toolMethods == null || !_toolMethods.Any())
        {
            <div style="text-align: center; padding: 2rem; color: #999;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">❌</div>
                <div>No tool methods found with [Description] attribute</div>
            </div>
        }
        else if (GroupByCategory)
        {
            @foreach (var category in _groupedMethods.Keys.OrderBy(k => k))
            {
                var isExpanded = _expandedCategories.Contains(category);
                
                <div style="margin-bottom: 1rem; background: white; border-radius: 6px; border: 1px solid #dee2e6; overflow: hidden;">
                    <button @onclick="() => ToggleCategory(category)" 
                            style="width: 100%; text-align: left; padding: 0.75rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: 600;">
                        <span>@category (@_groupedMethods[category].Count methods)</span>
                        <span style="font-size: 1.2rem;">@(isExpanded ? "▼" : "▶")</span>
                    </button>
                    
                    @if (isExpanded)
                    {
                        <div style="padding: 0.75rem;">
                            @foreach (var method in _groupedMethods[category])
                            {
                                <ToolMethodButton Method="@method" OnExecute="@(() => ExecuteMethod(method))" IsExecuting="@(_currentlyExecuting == method.MethodName)" />
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @foreach (var method in _toolMethods)
            {
                <ToolMethodButton Method="@method" OnExecute="@(() => ExecuteMethod(method))" IsExecuting="@(_currentlyExecuting == method.MethodName)" />
            }
        }

        <!-- Action Buttons -->
        @if (_toolMethods != null && _toolMethods.Any())
        {
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 2px solid #dee2e6; display: flex; gap: 0.5rem;">
                <button @onclick="ExecuteAllMethods" disabled="@_isExecuting" 
                        style="padding: 0.5rem 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; flex: 1;">
                    @if (_isExecuting)
                    {
                        <span>⏳ Running Tests...</span>
                    }
                    else
                    {
                        <span>▶️ Run All Tests</span>
                    }
                </button>
                <button @onclick="ClearResults" 
                        style="padding: 0.5rem 1rem; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer;">
                    🗑️ Clear Log
                </button>
            </div>
        }
    </div>
</div>
