@using FoundryMentorModeler.Model
@using FoundryMentorModeler.Tests
@using FoundryCore
@using FoundryRulesAndUnits.Models
@using BlazorComponentBus
@inherits ComponentBase
@inject ComponentBus PubSub
@inject IMentorServices MentorServices

@namespace Three2025.Components.Shared

<style>
    .success-tree-item {
        display: flex;
        margin: 0;
        padding: 2px 0;
        list-style-type: none;
        cursor: pointer;
        align-items: center;
        min-height: 20px;
    }

    .success-tree-item:hover {
        background-color: azure;
    }

    .success-tree-item.selected {
        background-color: lightblue;
    }

    .success-tree-item > .arrow, .success-tree-item > .arrow-placeholder {
        min-width: 16px;
        width: 16px;
        flex-shrink: 0;
        user-select: none;
    }

    .success-tree-item > .arrow:hover {
        color: steelblue;
    }

    .success-badge {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 6px;
        font-size: 10px;
        line-height: 1.2;
        border-radius: 3px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .success-badge.success {
        background: #28a745;
        color: white;
    }

    .success-badge.failure {
        background: #dc3545;
        color: white;
    }

    .success-badge.not-calculated {
        background: #6c757d;
        color: white;
    }

    .tree-action-btn {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 6px;
        font-size: 10px;
        line-height: 1.2;
        border: none;
        border-radius: 3px;
        background: #6c757d;
        color: white;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        flex-shrink: 0;
        height: auto;
        min-width: auto;
        width: auto;
    }

    .tree-action-btn:hover {
        background: #5a6268;
        color: white;
        text-decoration: none;
    }

    .tree-text {
        flex: 0 1 auto;
        margin-right: 6px;
        font-size: 12px;
        white-space: nowrap;
    }

    .calculated-checkbox {
        display: inline-block;
        margin-left: 6px;
        margin-right: 2px;
        font-size: 12px;
        color: #0066cc;
        flex-shrink: 0;
    }
</style>

@if (Items != null)
{
    foreach (var item in Items)
    {
        <li @key="@($"{item.GetHashCode()}_{item.GetTreeNodeTitle()}")" 
            class="success-tree-item@(item.GetIsSelected() ? " selected" : "")" 
            style="padding-left: @(Level * 16)px"
            @onclick="() => ItemSelected(item)">
            
            @if (item.HasChildren())
            {
                <span class="arrow" @onclick="() => ToggleExpanded(item)" @onclick:stopPropagation>
                    @(item.IsCollapsed() ? "▶" : "◢")
                </span>
            }
            else
            {
                <span class="arrow-placeholder"></span>
            }
            
            <span class="tree-text">@item.GetTreeNodeTitle()</span>

            @* Show checkbox for parameters with calculated values *@
            @if (item is KnParameter calcParam)
            {
                var isCalculated = calcParam.IsValid();
                if (isCalculated)
                {
                    <span class="calculated-checkbox">☑</span>
                }
                
                @* Show success badge only if parameter has a success test AND is currently calculated *@
                if (calcParam.HasSuccessTest())
                {
                    if (isCalculated)
                    {
                        var status = calcParam.EvaluateSuccess();
                        @if (status == CalculationStatus.Success)
                        {
                            <span class="success-badge success">✓</span>
                        }
                        else if (status == CalculationStatus.Failure)
                        {
                            <span class="success-badge failure">✗</span>
                        }
                        else
                        {
                            <span class="success-badge not-calculated">—</span>
                        }
                    }
                    else
                    {
                        <span class="success-badge not-calculated">—</span>
                    }
                }
            }

            @* Show action buttons *@
            @if (HasAnyActions(item))
            {
                @foreach (var action in GetDisplayActions(item))
                {
                    <button class="tree-action-btn" @onclick="() => ExecuteActionByIndex(item, action.IsKnAction, action.Index)" @onclick:stopPropagation>
                        @action.Name
                    </button>
                }
            }
        </li>

        @if (item.HasChildren() && !item.IsCollapsed())
        {
            <SuccessTreeItem 
                Items="@item.GetTreeChildren()" 
                Level="@(Level + 1)"
                OnSelect="ItemSelected">
            </SuccessTreeItem>
        }
    }
}

@code {
    [Parameter]
    public IEnumerable<ITreeNode>? Items { get; set; }

    [Parameter]
    public int Level { get; set; } = 0;

    [Parameter]
    public Action<ITreeNode>? OnSelect { get; set; }

    private void ItemSelected(ITreeNode item)
    {
        if (item != null)
        {
            item.SetSelected(!item.GetIsSelected());
            OnSelect?.Invoke(item);
            StateHasChanged();
        }
    }

    private void ToggleExpanded(ITreeNode item)
    {
        if (item != null)
        {
            item.SetExpanded(!item.GetIsExpanded());
            StateHasChanged();
        }
    }

    /// <summary>
    /// Check if item has any actions (either KnTreeNodeActions or TreeNodeActions)
    /// </summary>
    private bool HasAnyActions(ITreeNode item)
    {
        // Prefer KnTreeNodeActions if available (more powerful, has MentorServices context)
        if (item is IKnTreeNode knItem)
        {
            var knActions = knItem.GetKnTreeNodeActions();
            if (knActions != null && knActions.Any())
                return true;
        }
        
        // Fall back to base TreeNodeActions
        var actions = item.GetTreeNodeActions();
        return actions != null && actions.Any();
    }

    /// <summary>
    /// Get display actions for the tree item buttons.
    /// Returns KnTreeNodeActions as (Name, isKnAction:true) or TreeNodeActions as (Name, isKnAction:false)
    /// </summary>
    private IEnumerable<(string Name, string Style, bool IsKnAction, int Index)> GetDisplayActions(ITreeNode item)
    {
        // Prefer KnTreeNodeActions if available
        if (item is IKnTreeNode knItem)
        {
            var knActions = knItem.GetKnTreeNodeActions()?.ToList();
            if (knActions != null && knActions.Any())
            {
                return knActions.Select((a, i) => (a.Name, a.Style, true, i));
            }
        }
        
        // Fall back to base TreeNodeActions
        var actions = item.GetTreeNodeActions()?.ToList();
        if (actions != null && actions.Any())
        {
            return actions.Select((a, i) => (a.Name, a.Style, false, i));
        }
        
        return Enumerable.Empty<(string, string, bool, int)>();
    }

    /// <summary>
    /// Execute an action by index - handles both KnTreeNodeAction and TreeNodeAction
    /// </summary>
    private async Task ExecuteActionByIndex(ITreeNode item, bool isKnAction, int index)
    {
        if (isKnAction && item is IKnTreeNode knItem)
        {
            var knActions = knItem.GetKnTreeNodeActions()?.ToList();
            if (knActions != null && index < knActions.Count)
            {
                var action = knActions[index];
                action.Action.Invoke(MentorServices);
            }
        }
        else
        {
            var actions = item.GetTreeNodeActions()?.ToList();
            if (actions != null && index < actions.Count)
            {
                var action = actions[index];
                action.Action.Invoke();
            }
        }
        
        await Task.CompletedTask;
        StateHasChanged();
    }
}
